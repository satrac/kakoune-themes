# 10x-abyss theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Abyss.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:96c850
face global type          rgb:dcaa22
face global variable      rgb:b4a573
face global identifier    rgb:b4a573
face global module        rgb:dcaa22
face global function      rgb:ff773d
face global method        rgb:ff773d
face global string        rgb:d69d85
face global keyword       rgb:b482c8
face global operator      rgb:ffe6c8
face global attribute     rgb:72d8dc
face global comment       rgb:57a64a
face global documentation rgb:57a64a
face global meta          rgb:57a696
face global builtin       rgb:dcaa22+b
face global constant      rgb:96c850
face global error         rgb:ff6464

# Markup
face global title  rgb:b482c8+b
face global header rgb:72d8dc
face global mono   rgb:715f4a
face global block  rgb:dcaa22
face global link   rgb:b482c8+u
face global bullet rgb:dcdc00
face global list   rgb:b49673

# UI
face global Default                rgb:b49673,rgb:0c0c0c
face global PrimarySelection       rgb:0c0c0c,rgb:143b28
face global SecondarySelection     rgb:b49673,rgb:181613
face global PrimaryCursor          rgb:0c0c0c,rgb:32ff32+fg
face global SecondaryCursor        rgb:0c0c0c,rgb:715f4a+fg
face global PrimaryCursorEol       rgb:0c0c0c,rgb:32ff32+fg
face global SecondaryCursorEol     rgb:0c0c0c,rgb:2b91af+fg
face global MatchingChar           rgb:32ff32+b
face global MenuForeground         rgb:0c0c0c,rgb:b482c8
face global MenuBackground         rgb:b49673,rgb:0c0c0c
face global MenuInfo               rgb:b482c8
face global Information            rgb:0c0c0c,rgb:ffd370
face global InlineInformation      rgb:b49673,rgb:0c0c0c
face global Error                  rgb:0c0c0c,rgb:ff6464
face global DiagnosticError        rgb:ff6464
face global DiagnosticWarning      rgb:dcdc00
face global StatusLine             rgb:fadcdc,rgb:0c0c0c
face global StatusLineMode         rgb:fadcdc+b
face global StatusLineInfo         rgb:fadcdc
face global StatusLineValue        rgb:fadcdc+b
face global StatusCursor           rgb:0c0c0c,rgb:32ff32
face global Prompt                 rgb:b482c8
face global BufferPadding          rgb:2b91af,rgb:0c0c0c
face global LineNumbers            rgb:2b91af,rgb:0c0c0c
face global LineNumberCursor       rgb:b482c8,rgb:0c0c0c+b
face global LineNumbersWrapped     rgb:2b91af,rgb:0c0c0c+i
face global Whitespace             rgb:3e352b+f
face global WrapMarker             rgb:3e352b+f
face global Search                 rgb:b49673,rgb:5f2d00
face global DiffAdd                rgb:6fd85b,rgb:20351c
face global DiffRm                 rgb:ff6464,rgb:3d1e1e
face global DiffMeta               rgb:b482c8,rgb:36360a
face global MercurialCommitComment rgb:57a64a

