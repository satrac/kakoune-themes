# tokyo-night theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/tokyo-night.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:ff9e64
face global type          rgb:7dcfff
face global variable      rgb:c0caf5
face global identifier    rgb:c0caf5
face global module        rgb:7dcfff
face global function      rgb:7aa2f7
face global method        rgb:7aa2f7
face global string        rgb:9ece6a
face global keyword       rgb:bb9af7
face global operator      rgb:89ddff
face global attribute     rgb:7dcfff
face global comment       rgb:565f89+i
face global documentation rgb:707aa4
face global meta          rgb:f7768e
face global builtin       rgb:f7768e+b
face global constant      rgb:ff9e64
face global error         rgb:f7768e

# Markup
face global title  rgb:bb9af7+b
face global header rgb:7dcfff
face global mono   rgb:545c7e
face global block  rgb:bb9af7
face global link   rgb:bb9af7+u
face global bullet rgb:e0af68
face global list   rgb:c0caf5

# UI
face global Default                rgb:c0caf5,rgb:1a1b26
face global PrimarySelection       rgb:1a1b26,rgb:283457
face global SecondarySelection     rgb:c0caf5,rgb:2b2c3b
face global PrimaryCursor          rgb:1a1b26,rgb:c0caf5+fg
face global SecondaryCursor        rgb:1a1b26,rgb:545c7e+fg
face global PrimaryCursorEol       rgb:1a1b26,rgb:c0caf5+fg
face global SecondaryCursorEol     rgb:1a1b26,rgb:565f89+fg
face global MatchingChar           rgb:ff9e64+b
face global MenuForeground         rgb:1a1b26,rgb:bb9af7
face global MenuBackground         rgb:c0caf5,rgb:1f2335
face global MenuInfo               rgb:bb9af7
face global Information            rgb:1a1b26,rgb:e0af68
face global InlineInformation      rgb:c0caf5,rgb:1f2335
face global Error                  rgb:1a1b26,rgb:f7768e
face global DiagnosticError        rgb:f7768e
face global DiagnosticWarning      rgb:e0af68
face global StatusLine             rgb:1a1b26,rgb:7aa2f7
face global StatusLineMode         rgb:1a1b26+b
face global StatusLineInfo         rgb:1a1b26
face global StatusLineValue        rgb:1a1b26+b
face global StatusCursor           rgb:1a1b26,rgb:c0caf5
face global Prompt                 rgb:bb9af7
face global BufferPadding          rgb:656a83,rgb:1a1b26
face global LineNumbers            rgb:565f89,rgb:1a1b26
face global LineNumberCursor       rgb:bb9af7,rgb:1a1b26+b
face global LineNumbersWrapped     rgb:565f89,rgb:1a1b26+i
face global Whitespace             rgb:3b4261+f
face global WrapMarker             rgb:3b4261+f
face global Search                 rgb:1a1b26,rgb:e0af68
face global DiffAdd                rgb:73daca,rgb:20382e
face global DiffRm                 rgb:f7768e,rgb:3d222c
face global DiffMeta               rgb:bb9af7,rgb:23283e
face global MercurialCommitComment rgb:565f89

