# monochrome theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/monochrome.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:eeeeee
face global type          rgb:5e5e5e
face global variable      rgb:bbbbbb
face global identifier    rgb:bbbbbb
face global module        rgb:5e5e5e
face global function      rgb:8b8b8b
face global method        rgb:8b8b8b
face global string        rgb:d4d4d4
face global keyword       rgb:5e5e5e
face global operator      rgb:eeeeee
face global attribute     rgb:a3a3a3
face global comment       rgb:494949+i
face global documentation rgb:727272
face global meta          rgb:d4d4d4
face global builtin       rgb:d4d4d4+b
face global constant      rgb:eeeeee
face global error         rgb:d4d4d4

# Markup
face global title  rgb:5e5e5e+b
face global header rgb:a3a3a3
face global mono   rgb:8b8b8b
face global block  rgb:5e5e5e
face global link   rgb:5e5e5e+u
face global bullet rgb:eeeeee
face global list   rgb:eeeeee

# UI
face global Default                rgb:eeeeee,rgb:0e0e0e
face global PrimarySelection       rgb:0e0e0e,rgb:373737
face global SecondarySelection     rgb:eeeeee,rgb:242424
face global PrimaryCursor          rgb:0e0e0e,rgb:bbbbbb+fg
face global SecondaryCursor        rgb:0e0e0e,rgb:8b8b8b+fg
face global PrimaryCursorEol       rgb:0e0e0e,rgb:bbbbbb+fg
face global SecondaryCursorEol     rgb:0e0e0e,rgb:515151+fg
face global MatchingChar           rgb:bbbbbb+b
face global MenuForeground         rgb:0e0e0e,rgb:5e5e5e
face global MenuBackground         rgb:eeeeee,rgb:191919
face global MenuInfo               rgb:5e5e5e
face global Information            rgb:0e0e0e,rgb:eeeeee
face global InlineInformation      rgb:eeeeee,rgb:191919
face global Error                  rgb:0e0e0e,rgb:d4d4d4
face global DiagnosticError        rgb:d4d4d4
face global DiagnosticWarning      rgb:eeeeee
face global StatusLine             rgb:ffffff,rgb:191919
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:0e0e0e,rgb:bbbbbb
face global Prompt                 rgb:5e5e5e
face global BufferPadding          rgb:737373,rgb:0e0e0e
face global LineNumbers            rgb:515151,rgb:0e0e0e
face global LineNumberCursor       rgb:5e5e5e,rgb:0e0e0e+b
face global LineNumbersWrapped     rgb:515151,rgb:0e0e0e+i
face global Whitespace             rgb:3f3f3f+f
face global WrapMarker             rgb:3f3f3f+f
face global Search                 rgb:ffffff,rgb:525252
face global DiffAdd                rgb:bbbbbb,rgb:202020
face global DiffRm                 rgb:d4d4d4,rgb:222222
face global DiffMeta               rgb:5e5e5e,rgb:252525
face global MercurialCommitComment rgb:494949

