# kraihnight theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/kraihnight.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:d08356
face global type          rgb:d87d5f
face global variable      rgb:899ab4
face global identifier    rgb:899ab4
face global module        rgb:d87d5f
face global function      rgb:ab8252
face global method        rgb:ab8252
face global string        rgb:9fac7f
face global keyword       rgb:d6b67f
face global operator      rgb:f9f9f9
face global attribute     rgb:899ab4
face global comment       rgb:726d73+i
face global documentation rgb:949094
face global meta          rgb:d6b67f
face global builtin       rgb:d6b67f+b
face global constant      rgb:d08356
face global error         rgb:b98a8a

# Markup
face global title  rgb:d6b67f+b
face global header rgb:899ab4
face global mono   rgb:8a9597
face global block  rgb:d6b67f
face global link   rgb:d6b67f+u
face global bullet rgb:d6b67f
face global list   rgb:f9f9f9

# UI
face global Default                rgb:f9f9f9,rgb:1a1a1a
face global PrimarySelection       rgb:1a1a1a,rgb:404040
face global SecondarySelection     rgb:f9f9f9,rgb:303030
face global PrimaryCursor          rgb:1a1a1a,rgb:d6b67f+fg
face global SecondaryCursor        rgb:1a1a1a,rgb:8a9597+fg
face global PrimaryCursorEol       rgb:1a1a1a,rgb:d6b67f+fg
face global SecondaryCursorEol     rgb:1a1a1a,rgb:34383c+fg
face global MatchingChar           rgb:d6b67f+b
face global MenuForeground         rgb:1a1a1a,rgb:d6b67f
face global MenuBackground         rgb:f9f9f9,rgb:1e1e1e
face global MenuInfo               rgb:d6b67f
face global Information            rgb:1a1a1a,rgb:d6b67f
face global InlineInformation      rgb:f9f9f9,rgb:1e1e1e
face global Error                  rgb:1a1a1a,rgb:b98a8a
face global DiagnosticError        rgb:b98a8a
face global DiagnosticWarning      rgb:d6b67f
face global StatusLine             rgb:ffffff,rgb:1e1e1e
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:1a1a1a,rgb:d6b67f
face global Prompt                 rgb:d6b67f
face global BufferPadding          rgb:7e7e7e,rgb:1a1a1a
face global LineNumbers            rgb:34383c,rgb:1a1a1a
face global LineNumberCursor       rgb:d6b67f,rgb:1a1a1a+b
face global LineNumbersWrapped     rgb:34383c,rgb:1a1a1a+i
face global Whitespace             rgb:34383c+f
face global WrapMarker             rgb:34383c+f
face global Search                 rgb:f9f9f9,rgb:5b5b2b
face global DiffAdd                rgb:9fac7f,rgb:202b20
face global DiffRm                 rgb:b98a8a,rgb:2b2020
face global DiffMeta               rgb:d6b67f,rgb:2b251a
face global MercurialCommitComment rgb:726d73

