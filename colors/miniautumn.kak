# miniautumn theme for Kakoune
#
# Ported from Neovim's mini.hues palette (palettes/mini/miniautumn.lua).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:d7cef9
face global type          rgb:d7d5cd
face global variable      rgb:efcfab
face global identifier    rgb:efcfab
face global module        rgb:b4e2c7
face global function      rgb:a7e1e8
face global method        rgb:a7e1e8
face global string        rgb:d3daad
face global keyword       rgb:d7d5cd
face global operator      rgb:d7d5cd
face global attribute     rgb:b4e2c7
face global comment       rgb:97958e+i
face global documentation rgb:97958e
face global meta          rgb:d7cef9
face global builtin       rgb:a7e1e8+b
face global constant      rgb:d7cef9
face global error         rgb:f1c6e2

# Markup
face global title  rgb:e4caf1+b
face global header rgb:b4e2c7
face global mono   rgb:b7b5ad
face global block  rgb:d7cef9
face global link   rgb:e4caf1+u
face global bullet rgb:efcfab
face global list   rgb:d7d5cd

# UI
face global Default                rgb:d7d5cd,rgb:262029
face global PrimarySelection       rgb:262029,rgb:5e5762
face global SecondarySelection     rgb:d7d5cd,rgb:423b45
face global PrimaryCursor          rgb:262029,rgb:e4caf1+fg
face global SecondaryCursor        rgb:262029,rgb:b7b5ad+fg
face global PrimaryCursorEol       rgb:262029,rgb:e4caf1+fg
face global SecondaryCursorEol     rgb:262029,rgb:5e5762+fg
face global MatchingChar           rgb:e4caf1+b
face global MenuForeground         rgb:262029,rgb:e4caf1
face global MenuBackground         rgb:d7d5cd,rgb:1a141d
face global MenuInfo               rgb:e4caf1
face global Information            rgb:262029,rgb:efcfab
face global InlineInformation      rgb:d7d5cd,rgb:1a141d
face global Error                  rgb:262029,rgb:f1c6e2
face global DiagnosticError        rgb:f1c6e2
face global DiagnosticWarning      rgb:efcfab
face global StatusLine             rgb:b7b5ad,rgb:3a0f2f
face global StatusLineMode         rgb:b7b5ad+b
face global StatusLineInfo         rgb:b7b5ad
face global StatusLineValue        rgb:b7b5ad+b
face global StatusCursor           rgb:262029,rgb:e4caf1
face global Prompt                 rgb:e4caf1
face global BufferPadding          rgb:b7b5ad,rgb:262029
face global LineNumbers            rgb:5e5762,rgb:262029
face global LineNumberCursor       rgb:e4caf1,rgb:262029+b
face global LineNumbersWrapped     rgb:5e5762,rgb:262029+i
face global Whitespace             rgb:97958e+f
face global WrapMarker             rgb:97958e+f
face global Search                 rgb:262029,rgb:e4caf1
face global DiffAdd                rgb:d3daad,rgb:323700
face global DiffRm                 rgb:f1c6e2,rgb:3a0f2f
face global DiffMeta               rgb:e4caf1,rgb:003c24
face global MercurialCommitComment rgb:97958e

