# 10x-gold theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Gold.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:769151
face global type          rgb:f5d078
face global variable      rgb:f0f0e6
face global identifier    rgb:f0f0e6
face global module        rgb:ffda82
face global function      rgb:fa9b87
face global method        rgb:e1b9af
face global string        rgb:8cc9a0
face global keyword       rgb:f5c28f
face global operator      rgb:f5f2eb
face global attribute     rgb:dcae72
face global comment       rgb:969696
face global documentation rgb:969696
face global meta          rgb:648c9b
face global builtin       rgb:ffda82+b
face global constant      rgb:769151
face global error         rgb:ffc8b4

# Markup
face global title  rgb:f5c28f+b
face global header rgb:dcae72
face global mono   rgb:5a595a
face global block  rgb:7dd5de
face global link   rgb:f5c28f+u
face global bullet rgb:dcdc96
face global list   rgb:8c8c8c

# UI
face global Default                rgb:8c8c8c,rgb:0f0d0f
face global PrimarySelection       rgb:0f0d0f,rgb:dcb95a
face global SecondarySelection     rgb:8c8c8c,rgb:181618
face global PrimaryCursor          rgb:0f0d0f,rgb:ffffc8+fg
face global SecondaryCursor        rgb:0f0d0f,rgb:5a595a+fg
face global PrimaryCursorEol       rgb:0f0d0f,rgb:ffffc8+fg
face global SecondaryCursorEol     rgb:0f0d0f,rgb:646464+fg
face global MatchingChar           rgb:ffffc8+b
face global MenuForeground         rgb:0f0d0f,rgb:f5c28f
face global MenuBackground         rgb:8c8c8c,rgb:231e14
face global MenuInfo               rgb:f5c28f
face global Information            rgb:0f0d0f,rgb:ffd370
face global InlineInformation      rgb:8c8c8c,rgb:231e14
face global Error                  rgb:0f0d0f,rgb:ffc8b4
face global DiagnosticError        rgb:ffc8b4
face global DiagnosticWarning      rgb:dcdc96
face global StatusLine             rgb:f0f0f0,rgb:232127
face global StatusLineMode         rgb:f0f0f0+b
face global StatusLineInfo         rgb:f0f0f0
face global StatusLineValue        rgb:f0f0f0+b
face global StatusCursor           rgb:0f0d0f,rgb:ffffc8
face global Prompt                 rgb:f5c28f
face global BufferPadding          rgb:646464,rgb:0f0d0f
face global LineNumbers            rgb:646464,rgb:0f0d0f
face global LineNumberCursor       rgb:f5c28f,rgb:0f0d0f+b
face global LineNumbersWrapped     rgb:646464,rgb:0f0d0f+i
face global Whitespace             rgb:343334+f
face global WrapMarker             rgb:343334+f
face global Search                 rgb:000000,rgb:5f5819
face global DiffAdd                rgb:d8aa5b,rgb:372c1e
face global DiffRm                 rgb:ffc8b4,rgb:3f3230
face global DiffMeta               rgb:f5c28f,rgb:38362a
face global MercurialCommitComment rgb:969696

