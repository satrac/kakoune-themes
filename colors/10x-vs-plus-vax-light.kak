# 10x-vs-plus-vax-light theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/VS+VAX Light.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:000000
face global type          rgb:0000ff
face global variable      rgb:000080
face global identifier    rgb:000080
face global module        rgb:2b91af
face global function      rgb:880000
face global method        rgb:880000
face global string        rgb:7b5a5a
face global keyword       rgb:0000ff
face global operator      rgb:000000
face global attribute     rgb:5abedc
face global comment       rgb:008000
face global documentation rgb:008000
face global meta          rgb:c316b4
face global builtin       rgb:2b91af+b
face global constant      rgb:000000
face global error         rgb:ff0000

# Markup
face global title  rgb:0000ff+b
face global header rgb:5abedc
face global mono   rgb:666666
face global block  rgb:216f85
face global link   rgb:0000ff+u
face global bullet rgb:8c5a50
face global list   rgb:000000

# UI
face global Default                rgb:000000,rgb:ffffff
face global PrimarySelection       rgb:ffffff,rgb:99c9ef
face global SecondarySelection     rgb:000000,rgb:ffffff
face global PrimaryCursor          rgb:ffffff,rgb:000000+fg
face global SecondaryCursor        rgb:ffffff,rgb:666666+fg
face global PrimaryCursorEol       rgb:ffffff,rgb:000000+fg
face global SecondaryCursorEol     rgb:ffffff,rgb:999999+fg
face global MatchingChar           rgb:000000+b
face global MenuForeground         rgb:ffffff,rgb:0000ff
face global MenuBackground         rgb:000000,rgb:eeecea
face global MenuInfo               rgb:0000ff
face global Information            rgb:ffffff,rgb:a0a032
face global InlineInformation      rgb:000000,rgb:eeecea
face global Error                  rgb:ffffff,rgb:ff0000
face global DiagnosticError        rgb:ff0000
face global DiagnosticWarning      rgb:8c5a50
face global StatusLine             rgb:000000,rgb:eeecea
face global StatusLineMode         rgb:000000+b
face global StatusLineInfo         rgb:000000
face global StatusLineValue        rgb:000000+b
face global StatusCursor           rgb:ffffff,rgb:000000
face global Prompt                 rgb:0000ff
face global BufferPadding          rgb:808080,rgb:ffffff
face global LineNumbers            rgb:999999,rgb:ffffff
face global LineNumberCursor       rgb:0000ff,rgb:ffffff+b
face global LineNumbersWrapped     rgb:999999,rgb:ffffff+i
face global Whitespace             rgb:a6a6a6+f
face global WrapMarker             rgb:a6a6a6+f
face global Search                 rgb:000000,rgb:dcd264
face global DiffAdd                rgb:5bc847,rgb:def4da
face global DiffRm                 rgb:ff0000,rgb:ffcccc
face global DiffMeta               rgb:0000ff,rgb:e8dedc
face global MercurialCommitComment rgb:008000

