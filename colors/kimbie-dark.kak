# kimbie-dark theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/kimbie-dark.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:f79a32
face global type          rgb:f06431
face global variable      rgb:dc3958
face global identifier    rgb:dc3958
face global module        rgb:f06431
face global function      rgb:8ab1b0
face global method        rgb:8ab1b0
face global string        rgb:889b4a
face global keyword       rgb:98676a
face global operator      rgb:d3af86
face global attribute     rgb:8ab1b0
face global comment       rgb:a57a4c+i
face global documentation rgb:b0875a
face global meta          rgb:f79a32
face global builtin       rgb:f79a32+b
face global constant      rgb:f79a32
face global error         rgb:dc3958

# Markup
face global title  rgb:98676a+b
face global header rgb:8ab1b0
face global mono   rgb:a57a4c
face global block  rgb:98676a
face global link   rgb:98676a+u
face global bullet rgb:f79a32
face global list   rgb:d3af86

# UI
face global Default                rgb:d3af86,rgb:221a0f
face global PrimarySelection       rgb:221a0f,rgb:553917
face global SecondarySelection     rgb:d3af86,rgb:34291b
face global PrimaryCursor          rgb:221a0f,rgb:f79a32+fg
face global SecondaryCursor        rgb:221a0f,rgb:a57a4c+fg
face global PrimaryCursorEol       rgb:221a0f,rgb:f79a32+fg
face global SecondaryCursorEol     rgb:221a0f,rgb:a57a4c+fg
face global MatchingChar           rgb:f79a32+b
face global MenuForeground         rgb:221a0f,rgb:98676a
face global MenuBackground         rgb:d3af86,rgb:362712
face global MenuInfo               rgb:98676a
face global Information            rgb:221a0f,rgb:f79a32
face global InlineInformation      rgb:d3af86,rgb:362712
face global Error                  rgb:221a0f,rgb:dc3958
face global DiagnosticError        rgb:dc3958
face global DiagnosticWarning      rgb:f79a32
face global StatusLine             rgb:ffffff,rgb:423523
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:221a0f,rgb:f79a32
face global Prompt                 rgb:98676a
face global BufferPadding          rgb:725d45,rgb:221a0f
face global LineNumbers            rgb:a57a4c,rgb:221a0f
face global LineNumberCursor       rgb:98676a,rgb:221a0f+b
face global LineNumbersWrapped     rgb:a57a4c,rgb:221a0f+i
face global Whitespace             rgb:3c2d1b+f
face global WrapMarker             rgb:3c2d1b+f
face global Search                 rgb:ffffff,rgb:4f3518
face global DiffAdd                rgb:8ab1b0,rgb:2c2715
face global DiffRm                 rgb:dc3958,rgb:351d16
face global DiffMeta               rgb:98676a,rgb:382713
face global MercurialCommitComment rgb:a57a4c

