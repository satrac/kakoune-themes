# chocolatier theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/chocolatier-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:bb7d81
face global type          rgb:f4aa2b
face global variable      rgb:83a598
face global identifier    rgb:83a598
face global module        rgb:f4aa2b
face global function      rgb:db4664
face global method        rgb:db4664
face global string        rgb:889b4a
face global keyword       rgb:c33a2b+i
face global operator      rgb:e48212
face global attribute     rgb:83a598
face global comment       rgb:928374+i
face global documentation rgb:928374
face global meta          rgb:8ec07c
face global builtin       rgb:e48212+b
face global constant      rgb:bb7d81
face global error         rgb:c33a2b

# Markup
face global title  rgb:d3af86+b
face global header rgb:83a598
face global mono   rgb:8f7557
face global block  rgb:8ec07c
face global link   rgb:d3af86+u
face global bullet rgb:f4aa2b
face global list   rgb:d3af86

# UI
face global Default                rgb:d3af86,rgb:281f11
face global PrimarySelection       rgb:281f11,rgb:7c5f35
face global SecondarySelection     rgb:d3af86,rgb:372a16
face global PrimaryCursor          rgb:281f11,rgb:d3af86+fg
face global SecondaryCursor        rgb:281f11,rgb:8f7557+fg
face global PrimaryCursorEol       rgb:281f11,rgb:d3af86+fg
face global SecondaryCursorEol     rgb:281f11,rgb:8a693c+fg
face global MatchingChar           rgb:d3af86+b
face global MenuForeground         rgb:281f11,rgb:d3af86
face global MenuBackground         rgb:d3af86,rgb:372a16
face global MenuInfo               rgb:d3af86
face global Information            rgb:281f11,rgb:f4aa2b
face global InlineInformation      rgb:d3af86,rgb:372a16
face global Error                  rgb:281f11,rgb:c33a2b
face global DiagnosticError        rgb:c33a2b
face global DiagnosticWarning      rgb:f4aa2b
face global StatusLine             rgb:ebc295,rgb:4e3819
face global StatusLineMode         rgb:ebc295+b
face global StatusLineInfo         rgb:ebc295
face global StatusLineValue        rgb:ebc295+b
face global StatusCursor           rgb:281f11,rgb:d3af86
face global Prompt                 rgb:d3af86
face global BufferPadding          rgb:8a693c,rgb:281f11
face global LineNumbers            rgb:8a693c,rgb:281f11
face global LineNumberCursor       rgb:d3af86,rgb:281f11+b
face global LineNumbersWrapped     rgb:8a693c,rgb:281f11+i
face global Whitespace             rgb:644c2c+f
face global WrapMarker             rgb:644c2c+f
face global Search                 rgb:d3af86,rgb:88581f
face global DiffAdd                rgb:db4664,rgb:5e2b2a
face global DiffRm                 rgb:c33a2b,rgb:562719
face global DiffMeta               rgb:d3af86,rgb:654919
face global MercurialCommitComment rgb:928374

