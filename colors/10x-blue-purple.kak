# 10x-blue-purple theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Blue-Purple.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:c8c8c8
face global type          rgb:00ffff
face global variable      rgb:aafaff
face global identifier    rgb:aafaff
face global module        rgb:00ffff
face global function      rgb:3296ff
face global method        rgb:3296ff
face global string        rgb:c8c8c8
face global keyword       rgb:0096ff
face global operator      rgb:f0f0ff
face global attribute     rgb:72d8dc
face global comment       rgb:00ff00
face global documentation rgb:00ff00
face global meta          rgb:d8cda5
face global builtin       rgb:00ffff+b
face global constant      rgb:c8c8c8
face global error         rgb:ffb4b4

# Markup
face global title  rgb:0096ff+b
face global header rgb:72d8dc
face global mono   rgb:909099
face global block  rgb:9687ff
face global link   rgb:0096ff+u
face global bullet rgb:e6e6be
face global list   rgb:f0f0ff

# UI
face global Default                rgb:f0f0ff,rgb:000000
face global PrimarySelection       rgb:000000,rgb:003250
face global SecondarySelection     rgb:f0f0ff,rgb:111112
face global PrimaryCursor          rgb:000000,rgb:f0f0ff+fg
face global SecondaryCursor        rgb:000000,rgb:909099+fg
face global PrimaryCursorEol       rgb:000000,rgb:f0f0ff+fg
face global SecondaryCursorEol     rgb:000000,rgb:606066+fg
face global MatchingChar           rgb:f0f0ff+b
face global MenuForeground         rgb:000000,rgb:0096ff
face global MenuBackground         rgb:f0f0ff,rgb:2c2a28
face global MenuInfo               rgb:0096ff
face global Information            rgb:000000,rgb:ffd370
face global InlineInformation      rgb:f0f0ff,rgb:2c2a28
face global Error                  rgb:000000,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:2c2a28
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:000000,rgb:f0f0ff
face global Prompt                 rgb:0096ff
face global BufferPadding          rgb:606066,rgb:000000
face global LineNumbers            rgb:606066,rgb:000000
face global LineNumberCursor       rgb:0096ff,rgb:000000+b
face global LineNumbersWrapped     rgb:606066,rgb:000000+i
face global Whitespace             rgb:48484c+f
face global WrapMarker             rgb:48484c+f
face global Search                 rgb:f0f0ff,rgb:5f2d00
face global DiffAdd                rgb:6fd85b,rgb:162b12
face global DiffRm                 rgb:ffb4b4,rgb:332424
face global DiffMeta               rgb:0096ff,rgb:2e2e26
face global MercurialCommitComment rgb:00ff00

