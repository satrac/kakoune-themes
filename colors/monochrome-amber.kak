# monochrome-amber theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/monochrome-amber-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:fff1dd
face global type          rgb:bc7100
face global variable      rgb:ffc977
face global identifier    rgb:ffc977
face global module        rgb:bc7100
face global function      rgb:ffa217
face global method        rgb:ffa217
face global string        rgb:ffdda9
face global keyword       rgb:bc7100+i
face global operator      rgb:fff1dd
face global attribute     rgb:ffb547
face global comment       rgb:925800+i
face global documentation rgb:925800
face global meta          rgb:ffb547
face global builtin       rgb:ffdda9+b
face global constant      rgb:fff1dd
face global error         rgb:ffdda9

# Markup
face global title  rgb:ffc977+b
face global header rgb:ffb547
face global mono   rgb:a49785
face global block  rgb:ffb547
face global link   rgb:ffc977+u
face global bullet rgb:fff1dd
face global list   rgb:fff1dd

# UI
face global Default                rgb:fff1dd,rgb:1c1100
face global PrimarySelection       rgb:1c1100,rgb:7e6846
face global SecondarySelection     rgb:fff1dd,rgb:271c0b
face global PrimaryCursor          rgb:1c1100,rgb:ffc977+fg
face global SecondaryCursor        rgb:1c1100,rgb:a49785+fg
face global PrimaryCursorEol       rgb:1c1100,rgb:ffc977+fg
face global SecondaryCursorEol     rgb:1c1100,rgb:605442+fg
face global MatchingChar           rgb:ffc977+b
face global MenuForeground         rgb:1c1100,rgb:ffc977
face global MenuBackground         rgb:fff1dd,rgb:271c0b
face global MenuInfo               rgb:ffc977
face global Information            rgb:1c1100,rgb:fff1dd
face global InlineInformation      rgb:fff1dd,rgb:271c0b
face global Error                  rgb:1c1100,rgb:ffdda9
face global DiagnosticError        rgb:ffdda9
face global DiagnosticWarning      rgb:fff1dd
face global StatusLine             rgb:fff1dd,rgb:271c0b
face global StatusLineMode         rgb:fff1dd+b
face global StatusLineInfo         rgb:fff1dd
face global StatusLineValue        rgb:fff1dd+b
face global StatusCursor           rgb:1c1100,rgb:ffc977
face global Prompt                 rgb:ffc977
face global BufferPadding          rgb:605442,rgb:1c1100
face global LineNumbers            rgb:605442,rgb:1c1100
face global LineNumberCursor       rgb:ffc977,rgb:1c1100+b
face global LineNumbersWrapped     rgb:605442,rgb:1c1100+i
face global Whitespace             rgb:4e4231+f
face global WrapMarker             rgb:4e4231+f
face global Search                 rgb:fff1dd,rgb:a48e6b
face global DiffAdd                rgb:ffa217,rgb:603c07
face global DiffRm                 rgb:ffdda9,rgb:604e33
face global DiffMeta               rgb:ffc977,rgb:605442
face global MercurialCommitComment rgb:925800

