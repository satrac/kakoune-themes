# 10x-multi-coloured theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Multi-coloured.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:c8c8c8
face global type          rgb:00ffff
face global variable      rgb:ffaa50
face global identifier    rgb:ffaa50
face global module        rgb:00ffff
face global function      rgb:64ff64
face global method        rgb:00ff64
face global string        rgb:c8c8c8
face global keyword       rgb:00c8ff
face global operator      rgb:ffffff
face global attribute     rgb:72d8dc
face global comment       rgb:787878
face global documentation rgb:787878
face global meta          rgb:ffff00
face global builtin       rgb:00ffff+b
face global constant      rgb:c8c8c8
face global error         rgb:ffb4b4

# Markup
face global title  rgb:00c8ff+b
face global header rgb:72d8dc
face global mono   rgb:9f9ea1
face global block  rgb:8282ff
face global link   rgb:00c8ff+u
face global bullet rgb:e6e6be
face global list   rgb:ffffff

# UI
face global Default                rgb:ffffff,rgb:0f0d13
face global PrimarySelection       rgb:0f0d13,rgb:ffb400
face global SecondarySelection     rgb:ffffff,rgb:201e24
face global PrimaryCursor          rgb:0f0d13,rgb:ffffff+fg
face global SecondaryCursor        rgb:0f0d13,rgb:9f9ea1+fg
face global PrimaryCursorEol       rgb:0f0d13,rgb:ffffff+fg
face global SecondaryCursorEol     rgb:0f0d13,rgb:6f6e71+fg
face global MatchingChar           rgb:ffffff+b
face global MenuForeground         rgb:0f0d13,rgb:00c8ff
face global MenuBackground         rgb:ffffff,rgb:3c3732
face global MenuInfo               rgb:00c8ff
face global Information            rgb:0f0d13,rgb:ffd370
face global InlineInformation      rgb:ffffff,rgb:3c3732
face global Error                  rgb:0f0d13,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:3c3732
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:0f0d13,rgb:ffffff
face global Prompt                 rgb:00c8ff
face global BufferPadding          rgb:6f6e71,rgb:0f0d13
face global LineNumbers            rgb:6f6e71,rgb:0f0d13
face global LineNumberCursor       rgb:00c8ff,rgb:0f0d13+b
face global LineNumbersWrapped     rgb:6f6e71,rgb:0f0d13+i
face global Whitespace             rgb:57565a+f
face global WrapMarker             rgb:57565a+f
face global Search                 rgb:000000,rgb:5f2d00
face global DiffAdd                rgb:6fd85b,rgb:223621
face global DiffRm                 rgb:ffb4b4,rgb:3f2e33
face global DiffMeta               rgb:00c8ff,rgb:3a3835
face global MercurialCommitComment rgb:787878

