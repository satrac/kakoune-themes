# black-metal theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/black-metal-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:aaaaaa
face global type          rgb:e78a43
face global variable      rgb:c1c1c1
face global identifier    rgb:c1c1c1
face global module        rgb:e78a43
face global function      rgb:888888
face global method        rgb:888888
face global string        rgb:fbcb97
face global keyword       rgb:999999+i
face global operator      rgb:9b99a3
face global attribute     rgb:aaaaaa
face global comment       rgb:505050+i
face global documentation rgb:505050
face global meta          rgb:fbcb97
face global builtin       rgb:e78a43+b
face global constant      rgb:aaaaaa
face global error         rgb:5f8787

# Markup
face global title  rgb:5f8787+b
face global header rgb:aaaaaa
face global mono   rgb:747474
face global block  rgb:fbcb97
face global link   rgb:5f8787+u
face global bullet rgb:888888
face global list   rgb:c1c1c1

# UI
face global Default                rgb:c1c1c1,rgb:000000
face global PrimarySelection       rgb:000000,rgb:3b4545
face global SecondarySelection     rgb:c1c1c1,rgb:0a0a0a
face global PrimaryCursor          rgb:000000,rgb:5f8787+fg
face global SecondaryCursor        rgb:000000,rgb:747474+fg
face global PrimaryCursorEol       rgb:000000,rgb:5f8787+fg
face global SecondaryCursorEol     rgb:000000,rgb:3a3a3a+fg
face global MatchingChar           rgb:5f8787+b
face global MenuForeground         rgb:000000,rgb:5f8787
face global MenuBackground         rgb:c1c1c1,rgb:0a0a0a
face global MenuInfo               rgb:5f8787
face global Information            rgb:000000,rgb:888888
face global InlineInformation      rgb:c1c1c1,rgb:0a0a0a
face global Error                  rgb:000000,rgb:5f8787
face global DiagnosticError        rgb:5f8787
face global DiagnosticWarning      rgb:888888
face global StatusLine             rgb:c1c1c1,rgb:0a0a0a
face global StatusLineMode         rgb:c1c1c1+b
face global StatusLineInfo         rgb:c1c1c1
face global StatusLineValue        rgb:c1c1c1+b
face global StatusCursor           rgb:000000,rgb:5f8787
face global Prompt                 rgb:5f8787
face global BufferPadding          rgb:3a3a3a,rgb:000000
face global LineNumbers            rgb:3a3a3a,rgb:000000
face global LineNumberCursor       rgb:5f8787,rgb:000000+b
face global LineNumbersWrapped     rgb:3a3a3a,rgb:000000+i
face global Whitespace             rgb:2a2a2a+f
face global WrapMarker             rgb:2a2a2a+f
face global Search                 rgb:c1c1c1,rgb:696969
face global DiffAdd                rgb:888888,rgb:292929
face global DiffRm                 rgb:5f8787,rgb:1c2828
face global DiffMeta               rgb:5f8787,rgb:292929
face global MercurialCommitComment rgb:505050

