# 10x-gruvbox-dark theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/GruvboxDark.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:d3869b
face global type          rgb:fabd2f
face global variable      rgb:ebdbb2
face global identifier    rgb:ebdbb2
face global module        rgb:fabd2f
face global function      rgb:b8bb26
face global method        rgb:b8bb26
face global string        rgb:b8bb26
face global keyword       rgb:fb4934
face global operator      rgb:ebdbb2
face global attribute     rgb:dcae72
face global comment       rgb:928374
face global documentation rgb:928374
face global meta          rgb:8ec07c
face global builtin       rgb:fabd2f+b
face global constant      rgb:d3869b
face global error         rgb:ffb4b4

# Markup
face global title  rgb:fb4934+b
face global header rgb:dcae72
face global mono   rgb:9d937b
face global block  rgb:ffda82
face global link   rgb:fb4934+u
face global bullet rgb:e6e6be
face global list   rgb:ebdbb2

