# 10x-icing theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Icing.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:986801
face global type          rgb:0078b4
face global variable      rgb:000000
face global identifier    rgb:000000
face global module        rgb:006478
face global function      rgb:7b5c2b
face global method        rgb:7b5c2b
face global string        rgb:50a14f
face global keyword       rgb:aa0000
face global operator      rgb:000000
face global attribute     rgb:72d8dc
face global comment       rgb:a0a0a0
face global documentation rgb:a0a0a0
face global meta          rgb:746941
face global builtin       rgb:006478+b
face global constant      rgb:986801
face global error         rgb:ff3232

# Markup
face global title  rgb:aa0000+b
face global header rgb:72d8dc
face global mono   rgb:666666
face global block  rgb:2b91af
face global link   rgb:aa0000+u
face global bullet rgb:8c5a50
face global list   rgb:000000

# UI
face global Default                rgb:000000,rgb:ffffff
face global PrimarySelection       rgb:ffffff,rgb:9696dc
face global SecondarySelection     rgb:000000,rgb:ffffff
face global PrimaryCursor          rgb:ffffff,rgb:000000+fg
face global SecondaryCursor        rgb:ffffff,rgb:666666+fg
face global PrimaryCursorEol       rgb:ffffff,rgb:000000+fg
face global SecondaryCursorEol     rgb:ffffff,rgb:999999+fg
face global MatchingChar           rgb:000000+b
face global MenuForeground         rgb:ffffff,rgb:aa0000
face global MenuBackground         rgb:000000,rgb:eeecea
face global MenuInfo               rgb:aa0000
face global Information            rgb:ffffff,rgb:ffd370
face global InlineInformation      rgb:000000,rgb:eeecea
face global Error                  rgb:ffffff,rgb:ff3232
face global DiagnosticError        rgb:ff3232
face global DiagnosticWarning      rgb:8c5a50
face global StatusLine             rgb:000000,rgb:eeecea
face global StatusLineMode         rgb:000000+b
face global StatusLineInfo         rgb:000000
face global StatusLineValue        rgb:000000+b
face global StatusCursor           rgb:ffffff,rgb:000000
face global Prompt                 rgb:aa0000
face global BufferPadding          rgb:808080,rgb:ffffff
face global LineNumbers            rgb:999999,rgb:ffffff
face global LineNumberCursor       rgb:aa0000,rgb:ffffff+b
face global LineNumbersWrapped     rgb:999999,rgb:ffffff+i
face global Whitespace             rgb:a6a6a6+f
face global WrapMarker             rgb:a6a6a6+f
face global Search                 rgb:ffffff,rgb:dcd264
face global DiffAdd                rgb:6fd85b,rgb:e2f7de
face global DiffRm                 rgb:ff3232,rgb:ffd6d6
face global DiffMeta               rgb:aa0000,rgb:e8dedc
face global MercurialCommitComment rgb:a0a0a0

