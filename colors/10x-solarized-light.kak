# 10x-solarized-light theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/SolarizedLight.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:2aa198
face global type          rgb:b58900
face global variable      rgb:657b83
face global identifier    rgb:657b83
face global module        rgb:b58900
face global function      rgb:6c71c4
face global method        rgb:6c71c4
face global string        rgb:2aa198
face global keyword       rgb:859900
face global operator      rgb:d33682
face global attribute     rgb:5abedc
face global comment       rgb:93a1a1
face global documentation rgb:93a1a1
face global meta          rgb:cb4b16
face global builtin       rgb:b58900+b
face global constant      rgb:2aa198
face global error         rgb:ff0000

# Markup
face global title  rgb:859900+b
face global header rgb:5abedc
face global mono   rgb:a2aca9
face global block  rgb:b58900
face global link   rgb:859900+u
face global bullet rgb:966432
face global list   rgb:657b83

# UI
face global Default                rgb:657b83,rgb:fdf6e3
face global PrimarySelection       rgb:fdf6e3,rgb:8394ba
face global SecondarySelection     rgb:657b83,rgb:fdf7e7
face global PrimaryCursor          rgb:fdf6e3,rgb:657b83+fg
face global SecondaryCursor        rgb:fdf6e3,rgb:a2aca9+fg
face global PrimaryCursorEol       rgb:fdf6e3,rgb:657b83+fg
face global SecondaryCursorEol     rgb:fdf6e3,rgb:c0c5bd+fg
face global MatchingChar           rgb:657b83+b
face global MenuForeground         rgb:fdf6e3,rgb:859900
face global MenuBackground         rgb:657b83,rgb:eee8d5
face global MenuInfo               rgb:859900
face global Information            rgb:fdf6e3,rgb:a0a032
face global InlineInformation      rgb:657b83,rgb:eee8d5
face global Error                  rgb:fdf6e3,rgb:ff0000
face global DiagnosticError        rgb:ff0000
face global DiagnosticWarning      rgb:966432
face global StatusLine             rgb:073642,rgb:eee8d5
face global StatusLineMode         rgb:073642+b
face global StatusLineInfo         rgb:073642
face global StatusLineValue        rgb:073642+b
face global StatusCursor           rgb:fdf6e3,rgb:657b83
face global Prompt                 rgb:859900
face global BufferPadding          rgb:b1b8b3,rgb:fdf6e3
face global LineNumbers            rgb:c0c5bd,rgb:fdf6e3
face global LineNumberCursor       rgb:859900,rgb:fdf6e3+b
face global LineNumbersWrapped     rgb:c0c5bd,rgb:fdf6e3+i
face global Whitespace             rgb:c8cbc1+f
face global WrapMarker             rgb:c8cbc1+f
face global Search                 rgb:ffffff,rgb:dcd264
face global DiffAdd                rgb:5bc847,rgb:ddedc4
face global DiffRm                 rgb:ff0000,rgb:fdc5b6
face global DiffMeta               rgb:859900,rgb:e8d9c0
face global MercurialCommitComment rgb:93a1a1

