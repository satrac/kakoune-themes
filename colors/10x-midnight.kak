# 10x-midnight theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Midnight.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:569cd6
face global type          rgb:cc6600
face global variable      rgb:9cdcfe
face global identifier    rgb:9cdcfe
face global module        rgb:d7a500
face global function      rgb:dcdcaa
face global method        rgb:dcdcaa
face global string        rgb:6a8759
face global keyword       rgb:cc6600
face global operator      rgb:c8c8c8
face global attribute     rgb:72d8dc
face global comment       rgb:787878
face global documentation rgb:787878
face global meta          rgb:beb7ff
face global builtin       rgb:d7a500+b
face global constant      rgb:569cd6
face global error         rgb:ffb4b4

# Markup
face global title  rgb:cc6600+b
face global header rgb:72d8dc
face global mono   rgb:898889
face global block  rgb:4ec8af
face global link   rgb:cc6600+u
face global bullet rgb:e6e6be
face global list   rgb:c8c8c8

# UI
face global Default                rgb:c8c8c8,rgb:2a292b
face global PrimarySelection       rgb:2a292b,rgb:155096
face global SecondarySelection     rgb:c8c8c8,rgb:353436
face global PrimaryCursor          rgb:2a292b,rgb:c8c8c8+fg
face global SecondaryCursor        rgb:2a292b,rgb:898889+fg
face global PrimaryCursorEol       rgb:2a292b,rgb:c8c8c8+fg
face global SecondaryCursorEol     rgb:2a292b,rgb:2b91af+fg
face global MatchingChar           rgb:c8c8c8+b
face global MenuForeground         rgb:2a292b,rgb:cc6600
face global MenuBackground         rgb:c8c8c8,rgb:4b4b4e
face global MenuInfo               rgb:cc6600
face global Information            rgb:2a292b,rgb:ffd370
face global InlineInformation      rgb:c8c8c8,rgb:4b4b4e
face global Error                  rgb:2a292b,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:4b4b4e
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:2a292b,rgb:c8c8c8
face global Prompt                 rgb:cc6600
face global BufferPadding          rgb:2b91af,rgb:2a292b
face global LineNumbers            rgb:2b91af,rgb:2a292b
face global LineNumberCursor       rgb:cc6600,rgb:2a292b+b
face global LineNumbersWrapped     rgb:2b91af,rgb:2a292b+i
face global Whitespace             rgb:59595a+f
face global WrapMarker             rgb:59595a+f
face global Search                 rgb:c8c8c8,rgb:5f2d00
face global DiffAdd                rgb:6fd85b,rgb:384c35
face global DiffRm                 rgb:ffb4b4,rgb:554546
face global DiffMeta               rgb:cc6600,rgb:504f48
face global MercurialCommitComment rgb:787878

