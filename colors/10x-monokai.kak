# 10x-monokai theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Monokai.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:ad9df2
face global type          rgb:83dce7
face global variable      rgb:ffffff
face global identifier    rgb:ffffff
face global module        rgb:83dce7
face global function      rgb:abdc76
face global method        rgb:abdc76
face global string        rgb:fbd868
face global keyword       rgb:f8638a
face global operator      rgb:f8638a
face global attribute     rgb:72d8dc
face global comment       rgb:727272
face global documentation rgb:727272
face global meta          rgb:f8638a
face global builtin       rgb:83dce7+b
face global constant      rgb:ad9df2
face global error         rgb:ffb4b4

# Markup
face global title  rgb:f8638a+b
face global header rgb:72d8dc
face global mono   rgb:aaa9ab
face global block  rgb:f69969
face global link   rgb:f8638a+u
face global bullet rgb:e6e6be
face global list   rgb:ffffff

# UI
face global Default                rgb:ffffff,rgb:2b292e
face global PrimarySelection       rgb:2b292e,rgb:801008
face global SecondarySelection     rgb:ffffff,rgb:3a383d
face global PrimaryCursor          rgb:2b292e,rgb:ffffff+fg
face global SecondaryCursor        rgb:2b292e,rgb:aaa9ab+fg
face global PrimaryCursorEol       rgb:2b292e,rgb:ffffff+fg
face global SecondaryCursorEol     rgb:2b292e,rgb:807f82+fg
face global MatchingChar           rgb:ffffff+b
face global MenuForeground         rgb:2b292e,rgb:f8638a
face global MenuBackground         rgb:ffffff,rgb:1e1c22
face global MenuInfo               rgb:f8638a
face global Information            rgb:2b292e,rgb:ffd370
face global InlineInformation      rgb:ffffff,rgb:1e1c22
face global Error                  rgb:2b292e,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:1e1c22
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:2b292e,rgb:ffffff
face global Prompt                 rgb:f8638a
face global BufferPadding          rgb:807f82,rgb:2b292e
face global LineNumbers            rgb:807f82,rgb:2b292e
face global LineNumberCursor       rgb:f8638a,rgb:2b292e+b
face global LineNumbersWrapped     rgb:807f82,rgb:2b292e+i
face global Whitespace             rgb:6b696d+f
face global WrapMarker             rgb:6b696d+f
face global Search                 rgb:ffffff,rgb:5f2d00
face global DiffAdd                rgb:6fd85b,rgb:394c37
face global DiffRm                 rgb:ffb4b4,rgb:554549
face global DiffMeta               rgb:f8638a,rgb:504f4b
face global MercurialCommitComment rgb:727272

