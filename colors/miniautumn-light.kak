# miniautumn-light theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/miniautumn-light-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:351962
face global type          rgb:2f2e29
face global variable      rgb:2f2e29
face global identifier    rgb:2f2e29
face global module        rgb:2f2e29
face global function      rgb:006a74
face global method        rgb:006a74
face global string        rgb:4b5400
face global keyword       rgb:2f2e29+i
face global operator      rgb:2f2e29
face global attribute     rgb:003b6d
face global comment       rgb:686661+i
face global documentation rgb:686661
face global meta          rgb:2f2e29
face global builtin       rgb:005e3d+b
face global constant      rgb:351962
face global error         rgb:52073f

# Markup
face global title  rgb:431256+b
face global header rgb:003b6d
face global mono   rgb:787675
face global block  rgb:2f2e29
face global link   rgb:431256+u
face global bullet rgb:6c4300
face global list   rgb:2f2e29

# UI
face global Default                rgb:2f2e29,rgb:e5e1e7
face global PrimarySelection       rgb:e5e1e7,rgb:9c8da1
face global SecondarySelection     rgb:2f2e29,rgb:e9e6eb
face global PrimaryCursor          rgb:e5e1e7,rgb:431256+fg
face global SecondaryCursor        rgb:e5e1e7,rgb:787675+fg
face global PrimaryCursorEol       rgb:e5e1e7,rgb:431256+fg
face global SecondaryCursorEol     rgb:e5e1e7,rgb:a4a0a6+fg
face global MatchingChar           rgb:431256+b
face global MenuForeground         rgb:e5e1e7,rgb:431256
face global MenuBackground         rgb:2f2e29,rgb:eeeaf0
face global MenuInfo               rgb:431256
face global Information            rgb:e5e1e7,rgb:6c4300
face global InlineInformation      rgb:2f2e29,rgb:eeeaf0
face global Error                  rgb:e5e1e7,rgb:52073f
face global DiagnosticError        rgb:52073f
face global DiagnosticWarning      rgb:6c4300
face global StatusLine             rgb:2f2e29,rgb:ffb0e9
face global StatusLineMode         rgb:2f2e29+b
face global StatusLineInfo         rgb:2f2e29
face global StatusLineValue        rgb:2f2e29+b
face global StatusCursor           rgb:e5e1e7,rgb:431256
face global Prompt                 rgb:431256
face global BufferPadding          rgb:8a8888,rgb:e5e1e7
face global LineNumbers            rgb:a4a0a6,rgb:e5e1e7
face global LineNumberCursor       rgb:431256,rgb:e5e1e7+b
face global LineNumbersWrapped     rgb:a4a0a6,rgb:e5e1e7+i
face global Whitespace             rgb:a5a2a4+f
face global WrapMarker             rgb:a5a2a4+f
face global Search                 rgb:2f2e29,rgb:9f8c74
face global DiffAdd                rgb:006a74,rgb:a0bdc4
face global DiffRm                 rgb:52073f,rgb:b9a0b5
face global DiffMeta               rgb:431256,rgb:c1b2a2
face global MercurialCommitComment rgb:686661

