# 10x-high-contrast theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/High-Contrast.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:e6e6e6
face global type          rgb:00ffff
face global variable      rgb:ffffff
face global identifier    rgb:ffffff
face global module        rgb:00ffff
face global function      rgb:e6e6ff
face global method        rgb:e6e6ff
face global string        rgb:c8c8c8
face global keyword       rgb:64c8ff
face global operator      rgb:ffffff
face global attribute     rgb:72d8dc
face global comment       rgb:ffffff
face global documentation rgb:ffffff
face global meta          rgb:d8cda5
face global builtin       rgb:00ffff+b
face global constant      rgb:e6e6e6
face global error         rgb:ffb4b4

# Markup
face global title  rgb:64c8ff+b
face global header rgb:72d8dc
face global mono   rgb:999999
face global block  rgb:ffffff
face global link   rgb:64c8ff+u
face global bullet rgb:e6e6be
face global list   rgb:ffffff

# UI
face global Default                rgb:ffffff,rgb:000000
face global PrimarySelection       rgb:000000,rgb:ffffff
face global SecondarySelection     rgb:ffffff,rgb:121212
face global PrimaryCursor          rgb:000000,rgb:ffffff+fg
face global SecondaryCursor        rgb:000000,rgb:999999+fg
face global PrimaryCursorEol       rgb:000000,rgb:ffffff+fg
face global SecondaryCursorEol     rgb:000000,rgb:666666+fg
face global MatchingChar           rgb:ffffff+b
face global MenuForeground         rgb:000000,rgb:64c8ff
face global MenuBackground         rgb:ffffff,rgb:1e1e1e
face global MenuInfo               rgb:64c8ff
face global Information            rgb:000000,rgb:ffd370
face global InlineInformation      rgb:ffffff,rgb:1e1e1e
face global Error                  rgb:000000,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:1e1e1e
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:000000,rgb:ffffff
face global Prompt                 rgb:64c8ff
face global BufferPadding          rgb:666666,rgb:000000
face global LineNumbers            rgb:666666,rgb:000000
face global LineNumberCursor       rgb:64c8ff,rgb:000000+b
face global LineNumbersWrapped     rgb:666666,rgb:000000+i
face global Whitespace             rgb:4c4c4c+f
face global WrapMarker             rgb:4c4c4c+f
face global Search                 rgb:000000,rgb:5f2d00
face global DiffAdd                rgb:6fd85b,rgb:162b12
face global DiffRm                 rgb:ffb4b4,rgb:332424
face global DiffMeta               rgb:64c8ff,rgb:2e2e26
face global MercurialCommitComment rgb:ffffff

