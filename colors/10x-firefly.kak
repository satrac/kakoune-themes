# 10x-firefly theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Firefly.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:85b2fe
face global type          rgb:00b880
face global variable      rgb:b0e0e6
face global identifier    rgb:b0e0e6
face global module        rgb:b0e0e6
face global function      rgb:b0e0e6
face global method        rgb:b0e0e6
face global string        rgb:9a85ff
face global keyword       rgb:cc4455
face global operator      rgb:c8c8c8
face global attribute     rgb:72d8dc
face global comment       rgb:557f8f
face global documentation rgb:557f8f
face global meta          rgb:00b880
face global builtin       rgb:b0e0e6+b
face global constant      rgb:85b2fe
face global error         rgb:ffb4b4

# Markup
face global title  rgb:cc4455+b
face global header rgb:72d8dc
face global mono   rgb:6c9699
face global block  rgb:b0e0e6
face global link   rgb:cc4455+u
face global bullet rgb:e6e6be
face global list   rgb:b0e0e6

# UI
face global Default                rgb:b0e0e6,rgb:062826
face global PrimarySelection       rgb:062826,rgb:55d5e3
face global SecondarySelection     rgb:b0e0e6,rgb:123533
face global PrimaryCursor          rgb:062826,rgb:b0e0e6+fg
face global SecondaryCursor        rgb:062826,rgb:6c9699+fg
face global PrimaryCursorEol       rgb:062826,rgb:b0e0e6+fg
face global SecondaryCursorEol     rgb:062826,rgb:698b69+fg
face global MatchingChar           rgb:b0e0e6+b
face global MenuForeground         rgb:062826,rgb:cc4455
face global MenuBackground         rgb:b0e0e6,rgb:021e1c
face global MenuInfo               rgb:cc4455
face global Information            rgb:062826,rgb:ffd370
face global InlineInformation      rgb:b0e0e6,rgb:021e1c
face global Error                  rgb:062826,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:021e1c
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:062826,rgb:b0e0e6
face global Prompt                 rgb:cc4455
face global BufferPadding          rgb:698b69,rgb:062826
face global LineNumbers            rgb:698b69,rgb:062826
face global LineNumberCursor       rgb:cc4455,rgb:062826+b
face global LineNumbersWrapped     rgb:698b69,rgb:062826+i
face global Whitespace             rgb:395f60+f
face global WrapMarker             rgb:395f60+f
face global Search                 rgb:000080,rgb:5f2d00
face global DiffAdd                rgb:6fd85b,rgb:1b4b31
face global DiffRm                 rgb:ffb4b4,rgb:384442
face global DiffMeta               rgb:cc4455,rgb:334e44
face global MercurialCommitComment rgb:557f8f

