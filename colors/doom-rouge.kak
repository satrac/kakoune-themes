# doom-rouge theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/doom-rouge-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:eabe9a
face global type          rgb:c6797e
face global variable      rgb:c6797e
face global identifier    rgb:c6797e
face global module        rgb:c6797e
face global function      rgb:f9b5ac
face global method        rgb:f9b5ac
face global string        rgb:a3b09a
face global keyword       rgb:b18bb1+i
face global operator      rgb:b18bb1
face global attribute     rgb:6e94b9
face global comment       rgb:a3b09a+i
face global documentation rgb:a3b09a
face global meta          rgb:b18bb1
face global builtin       rgb:db6e8f+b
face global constant      rgb:c6797e
face global error         rgb:c6797e

# Markup
face global title  rgb:fafff6+b
face global header rgb:6e94b9
face global mono   rgb:9fa6a7
face global block  rgb:b18bb1
face global link   rgb:fafff6+u
face global bullet rgb:f7e3af
face global list   rgb:fafff6

# UI
face global Default                rgb:fafff6,rgb:172030
face global PrimarySelection       rgb:172030,rgb:5d636e
face global SecondarySelection     rgb:fafff6,rgb:151d2b
face global PrimaryCursor          rgb:172030,rgb:fafff6+fg
face global SecondaryCursor        rgb:172030,rgb:9fa6a7+fg
face global PrimaryCursorEol       rgb:172030,rgb:fafff6+fg
face global SecondaryCursorEol     rgb:172030,rgb:838e97+fg
face global MatchingChar           rgb:fafff6+b
face global MenuForeground         rgb:172030,rgb:fafff6
face global MenuBackground         rgb:fafff6,rgb:151d2b
face global MenuInfo               rgb:fafff6
face global Information            rgb:172030,rgb:f7e3af
face global InlineInformation      rgb:fafff6,rgb:151d2b
face global Error                  rgb:172030,rgb:c6797e
face global DiagnosticError        rgb:c6797e
face global DiagnosticWarning      rgb:f7e3af
face global StatusLine             rgb:fafff6,rgb:0e131d
face global StatusLineMode         rgb:fafff6+b
face global StatusLineInfo         rgb:fafff6
face global StatusLineValue        rgb:fafff6+b
face global StatusCursor           rgb:172030,rgb:fafff6
face global Prompt                 rgb:fafff6
face global BufferPadding          rgb:838e97,rgb:172030
face global LineNumbers            rgb:838e97,rgb:172030
face global LineNumberCursor       rgb:fafff6,rgb:172030+b
face global LineNumbersWrapped     rgb:838e97,rgb:172030+i
face global Whitespace             rgb:1f2a3f+f
face global WrapMarker             rgb:1f2a3f+f
face global Search                 rgb:fafff6,rgb:5a545e
face global DiffAdd                rgb:f9b5ac,rgb:5b4d55
face global DiffRm                 rgb:c6797e,rgb:4c3b47
face global DiffMeta               rgb:fafff6,rgb:5a5a56
face global MercurialCommitComment rgb:a3b09a

