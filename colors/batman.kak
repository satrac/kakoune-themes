# batman theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/batman-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:c8be46
face global type          rgb:909495
face global variable      rgb:747271
face global identifier    rgb:747271
face global module        rgb:909495
face global function      rgb:feed6c
face global method        rgb:feed6c
face global string        rgb:e6dc44
face global keyword       rgb:f4fd22+i
face global operator      rgb:c5c5be
face global attribute     rgb:737174
face global comment       rgb:62605f+i
face global documentation rgb:62605f
face global meta          rgb:909495
face global builtin       rgb:a3a3a6+b
face global constant      rgb:c8be46
face global error         rgb:e6dc44

# Markup
face global title  rgb:fcee0b+b
face global header rgb:737174
face global mono   rgb:81827e
face global block  rgb:909495
face global link   rgb:fcee0b+u
face global bullet rgb:f4fd22
face global list   rgb:c5c5be

# UI
face global Default                rgb:c5c5be,rgb:1b1d1e
face global PrimarySelection       rgb:1b1d1e,rgb:726f38
face global SecondarySelection     rgb:c5c5be,rgb:242526
face global PrimaryCursor          rgb:1b1d1e,rgb:fcee0b+fg
face global SecondaryCursor        rgb:1b1d1e,rgb:81827e+fg
face global PrimaryCursorEol       rgb:1b1d1e,rgb:fcee0b+fg
face global SecondaryCursorEol     rgb:1b1d1e,rgb:4e4f4e+fg
face global MatchingChar           rgb:fcee0b+b
face global MenuForeground         rgb:1b1d1e,rgb:fcee0b
face global MenuBackground         rgb:c5c5be,rgb:242526
face global MenuInfo               rgb:fcee0b
face global Information            rgb:1b1d1e,rgb:f4fd22
face global InlineInformation      rgb:c5c5be,rgb:242526
face global Error                  rgb:1b1d1e,rgb:e6dc44
face global DiagnosticError        rgb:e6dc44
face global DiagnosticWarning      rgb:f4fd22
face global StatusLine             rgb:c5c5be,rgb:242526
face global StatusLineMode         rgb:c5c5be+b
face global StatusLineInfo         rgb:c5c5be
face global StatusLineValue        rgb:c5c5be+b
face global StatusCursor           rgb:1b1d1e,rgb:fcee0b
face global Prompt                 rgb:fcee0b
face global BufferPadding          rgb:4e4f4e,rgb:1b1d1e
face global LineNumbers            rgb:4e4f4e,rgb:1b1d1e
face global LineNumberCursor       rgb:fcee0b,rgb:1b1d1e+b
face global LineNumbersWrapped     rgb:4e4f4e,rgb:1b1d1e+i
face global Whitespace             rgb:404241+f
face global WrapMarker             rgb:404241+f
face global Search                 rgb:c5c5be,rgb:9e9655
face global DiffAdd                rgb:feed6c,rgb:5f5b35
face global DiffRm                 rgb:e6dc44,rgb:585629
face global DiffMeta               rgb:fcee0b,rgb:5c601f
face global MercurialCommitComment rgb:62605f

