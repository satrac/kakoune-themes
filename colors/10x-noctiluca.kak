# 10x-noctiluca theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Noctiluca.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:c88cff
face global type          rgb:5fcdc8
face global variable      rgb:e4eaf5
face global identifier    rgb:e4eaf5
face global module        rgb:5fcdc8
face global function      rgb:aac8ff
face global method        rgb:aac8ff
face global string        rgb:78ffc8
face global keyword       rgb:46aaff
face global operator      rgb:969baf
face global attribute     rgb:aa8cff
face global comment       rgb:788296
face global documentation rgb:879bb9
face global meta          rgb:9678cd
face global builtin       rgb:5fcdc8+b
face global constant      rgb:c88cff
face global error         rgb:ff5064

# Markup
face global title  rgb:5ae1ff+b
face global header rgb:aa8cff
face global mono   rgb:8c939a
face global block  rgb:5fcdc8
face global link   rgb:5ae1ff+u
face global bullet rgb:ffc85a
face global list   rgb:e6f2fa

# UI
face global Default                rgb:e6f2fa,rgb:06040a
face global PrimarySelection       rgb:06040a,rgb:16507d
face global SecondarySelection     rgb:e6f2fa,rgb:16151b
face global PrimaryCursor          rgb:06040a,rgb:78f0ff+fg
face global SecondaryCursor        rgb:06040a,rgb:8c939a+fg
face global PrimaryCursorEol       rgb:06040a,rgb:78f0ff+fg
face global SecondaryCursorEol     rgb:06040a,rgb:78788c+fg
face global MatchingChar           rgb:78f0ff+b
face global MenuForeground         rgb:06040a,rgb:5ae1ff
face global MenuBackground         rgb:e6f2fa,rgb:08060e
face global MenuInfo               rgb:5ae1ff
face global Information            rgb:06040a,rgb:ffc85a
face global InlineInformation      rgb:e6f2fa,rgb:08060e
face global Error                  rgb:06040a,rgb:ff5064
face global DiagnosticError        rgb:ff5064
face global DiagnosticWarning      rgb:ffc85a
face global StatusLine             rgb:e1f5fa,rgb:124852
face global StatusLineMode         rgb:e1f5fa+b
face global StatusLineInfo         rgb:e1f5fa
face global StatusLineValue        rgb:e1f5fa+b
face global StatusCursor           rgb:06040a,rgb:78f0ff
face global Prompt                 rgb:5ae1ff
face global BufferPadding          rgb:78788c,rgb:06040a
face global LineNumbers            rgb:78788c,rgb:06040a
face global LineNumberCursor       rgb:5ae1ff,rgb:06040a+b
face global LineNumbersWrapped     rgb:78788c,rgb:06040a+i
face global Whitespace             rgb:494b52+f
face global WrapMarker             rgb:494b52+f
face global Search                 rgb:e6f2fa,rgb:ffc850
face global DiffAdd                rgb:78ffc8,rgb:1d3630
face global DiffRm                 rgb:ff5064,rgb:38131c
face global DiffMeta               rgb:5ae1ff,rgb:382b1a
face global MercurialCommitComment rgb:788296

