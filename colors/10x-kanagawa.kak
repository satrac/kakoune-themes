# 10x-kanagawa theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Kanagawa.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:d17b87
face global type          rgb:957fb8
face global variable      rgb:9cdcfe
face global identifier    rgb:9cdcfe
face global module        rgb:4ac8aa
face global function      rgb:dbd8a1
face global method        rgb:dbd8a1
face global string        rgb:98bb6c
face global keyword       rgb:957fb8
face global operator      rgb:c0a36e
face global attribute     rgb:72d8dc
face global comment       rgb:727169
face global documentation rgb:727169
face global meta          rgb:9b9b9b
face global builtin       rgb:4ac8aa+b
face global constant      rgb:d17b87
face global error         rgb:ff5555

# Markup
face global title  rgb:957fb8+b
face global header rgb:72d8dc
face global mono   rgb:69696d
face global block  rgb:4ac8aa
face global link   rgb:957fb8+u
face global bullet rgb:ffd75f
face global list   rgb:9b9b9b

# UI
face global Default                rgb:9b9b9b,rgb:1f1f28
face global PrimarySelection       rgb:1f1f28,rgb:223249
face global SecondarySelection     rgb:9b9b9b,rgb:282830
face global PrimaryCursor          rgb:1f1f28,rgb:9b9b9b+fg
face global SecondaryCursor        rgb:1f1f28,rgb:69696d+fg
face global PrimaryCursorEol       rgb:1f1f28,rgb:9b9b9b+fg
face global SecondaryCursorEol     rgb:1f1f28,rgb:515156+fg
face global MatchingChar           rgb:9b9b9b+b
face global MenuForeground         rgb:1f1f28,rgb:957fb8
face global MenuBackground         rgb:9b9b9b,rgb:16161d
face global MenuInfo               rgb:957fb8
face global Information            rgb:1f1f28,rgb:ffd370
face global InlineInformation      rgb:9b9b9b,rgb:16161d
face global Error                  rgb:1f1f28,rgb:ff5555
face global DiagnosticError        rgb:ff5555
face global DiagnosticWarning      rgb:ffd75f
face global StatusLine             rgb:dddddd,rgb:363646
face global StatusLineMode         rgb:dddddd+b
face global StatusLineInfo         rgb:dddddd
face global StatusLineValue        rgb:dddddd+b
face global StatusCursor           rgb:1f1f28,rgb:9b9b9b
face global Prompt                 rgb:957fb8
face global BufferPadding          rgb:515156,rgb:1f1f28
