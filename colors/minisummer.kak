# minisummer theme for Kakoune
#
# Ported from Neovim's mini.hues palette (palettes/mini/minisummer.lua).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:d8caff
face global type          rgb:d2d4db
face global variable      rgb:f6cc9b
face global identifier    rgb:f6cc9b
face global module        rgb:a6e5c3
face global function      rgb:93e4ee
face global method        rgb:93e4ee
face global string        rgb:d1db9f
face global keyword       rgb:d2d4db
face global operator      rgb:d2d4db
face global attribute     rgb:a6e5c3
face global comment       rgb:93949b+i
face global documentation rgb:93949b
face global meta          rgb:d8caff
face global builtin       rgb:93e4ee+b
face global constant      rgb:d8caff
face global error         rgb:fac0e4

# Markup
face global title  rgb:f6cc9b+b
face global header rgb:a6e5c3
face global mono   rgb:b2b4bb
face global block  rgb:d8caff
face global link   rgb:f6cc9b+u
face global bullet rgb:f6cc9b
face global list   rgb:d2d4db

# UI
face global Default                rgb:d2d4db,rgb:27211e
face global PrimarySelection       rgb:27211e,rgb:605855
face global SecondarySelection     rgb:d2d4db,rgb:433c39
face global PrimaryCursor          rgb:27211e,rgb:f6cc9b+fg
face global SecondaryCursor        rgb:27211e,rgb:b2b4bb+fg
face global PrimaryCursorEol       rgb:27211e,rgb:f6cc9b+fg
face global SecondaryCursorEol     rgb:27211e,rgb:605855+fg
face global MatchingChar           rgb:f6cc9b+b
face global MenuForeground         rgb:27211e,rgb:f6cc9b
face global MenuBackground         rgb:d2d4db,rgb:1b1512
face global MenuInfo               rgb:f6cc9b
face global Information            rgb:27211e,rgb:f6cc9b
face global InlineInformation      rgb:d2d4db,rgb:1b1512
face global Error                  rgb:27211e,rgb:fac0e4
face global DiagnosticError        rgb:fac0e4
face global DiagnosticWarning      rgb:f6cc9b
face global StatusLine             rgb:b2b4bb,rgb:492c00
face global StatusLineMode         rgb:b2b4bb+b
face global StatusLineInfo         rgb:b2b4bb
face global StatusLineValue        rgb:b2b4bb+b
face global StatusCursor           rgb:27211e,rgb:f6cc9b
face global Prompt                 rgb:f6cc9b
face global BufferPadding          rgb:b2b4bb,rgb:27211e
face global LineNumbers            rgb:605855,rgb:27211e
