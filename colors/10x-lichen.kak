# 10x-lichen theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Lichen.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:96c378
face global type          rgb:50b4d2
face global variable      rgb:b4cdb4
face global identifier    rgb:b4cdb4
face global module        rgb:96cd64
face global function      rgb:5abeaf
face global method        rgb:55afa5
face global string        rgb:64bea0
face global keyword       rgb:64c346
face global operator      rgb:8ca587
face global attribute     rgb:64b9be
face global comment       rgb:5f825f
face global documentation rgb:698c64
face global meta          rgb:8cb496
face global builtin       rgb:96cd64+b
face global constant      rgb:96c378
face global error         rgb:eba5a5

# Markup
face global title  rgb:46cd6e+b
face global header rgb:64b9be
face global mono   rgb:7f8e80
face global block  rgb:96cd64
face global link   rgb:46cd6e+u
face global bullet rgb:d7d4af
face global list   rgb:cde1cd

# UI
face global Default                rgb:cde1cd,rgb:0a120c
face global PrimarySelection       rgb:0a120c,rgb:2d6e37
face global SecondarySelection     rgb:cde1cd,rgb:18201a
face global PrimaryCursor          rgb:0a120c,rgb:d2a03c+fg
face global SecondaryCursor        rgb:0a120c,rgb:7f8e80+fg
face global PrimaryCursorEol       rgb:0a120c,rgb:d2a03c+fg
face global SecondaryCursorEol     rgb:0a120c,rgb:5f7864+fg
face global MatchingChar           rgb:d2a03c+b
face global MenuForeground         rgb:0a120c,rgb:46cd6e
face global MenuBackground         rgb:cde1cd,rgb:0e1a10
face global MenuInfo               rgb:46cd6e
face global Information            rgb:0a120c,rgb:d2b469
face global InlineInformation      rgb:cde1cd,rgb:0e1a10
face global Error                  rgb:0a120c,rgb:eba5a5
face global DiagnosticError        rgb:eba5a5
face global DiagnosticWarning      rgb:d7d4af
face global StatusLine             rgb:dcebdc,rgb:28782d
face global StatusLineMode         rgb:dcebdc+b
face global StatusLineInfo         rgb:dcebdc
face global StatusLineValue        rgb:dcebdc+b
face global StatusCursor           rgb:0a120c,rgb:d2a03c
face global Prompt                 rgb:46cd6e
face global BufferPadding          rgb:5f7864,rgb:0a120c
face global LineNumbers            rgb:5f7864,rgb:101a12
face global LineNumberCursor       rgb:46cd6e,rgb:101a12+b
face global LineNumbersWrapped     rgb:5f7864,rgb:101a12+i
face global Whitespace             rgb:374b3a+f
face global WrapMarker             rgb:374b3a+f
face global Search                 rgb:0f1610,rgb:6e370a
