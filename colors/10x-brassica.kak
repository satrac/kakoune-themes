face global module        rgb:8ce6b0
face global function      rgb:d9cdba
face global method        rgb:d9cdba
face global string        rgb:6cc4b4
face global keyword       rgb:d1eaf0
face global operator      rgb:b5ac9a
face global attribute     rgb:72d8dc
face global comment       rgb:60cd71
face global documentation rgb:60cd71
face global meta          rgb:c3f7b2
face global builtin       rgb:8ce6b0+b
face global constant      rgb:81e3e0
face global error         rgb:ffb4b4

# Markup
face global title  rgb:d1eaf0+b
face global header rgb:72d8dc
