# 10x-brassica theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Brassica.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:81e3e0
face global type          rgb:a7dbbc
