# nightfly theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/nightfly.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:f78c6c
face global type          rgb:21c7a8
face global variable      rgb:c3ccdc
face global identifier    rgb:c3ccdc
face global module        rgb:21c7a8
face global function      rgb:82aaff
face global method        rgb:82aaff
face global string        rgb:ecc48d
face global keyword       rgb:c792ea
face global operator      rgb:ff5874
face global attribute     rgb:7fdbca
face global comment       rgb:7c8f8f+i
face global documentation rgb:8e9ea2
face global meta          rgb:a1cd5e
face global builtin       rgb:a1cd5e+b
face global constant      rgb:f78c6c
face global error         rgb:ff5874

# Markup
face global title  rgb:c792ea+b
face global header rgb:7fdbca
face global mono   rgb:4b6479
face global block  rgb:c792ea
face global link   rgb:c792ea+u
face global bullet rgb:f78c6c
face global list   rgb:c3ccdc

# UI
face global Default                rgb:c3ccdc,rgb:011627
face global PrimarySelection       rgb:011627,rgb:1d3b53
