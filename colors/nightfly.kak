face global SecondaryCursor        rgb:011627,rgb:4b6479+fg
face global PrimaryCursorEol       rgb:011627,rgb:82aaff+fg
face global SecondaryCursorEol     rgb:011627,rgb:4b6479+fg
face global MatchingChar           rgb:82aaff+b
face global MenuForeground         rgb:011627,rgb:c792ea
face global MenuBackground         rgb:c3ccdc,rgb:09243a
face global MenuInfo               rgb:c792ea
face global Information            rgb:011627,rgb:f78c6c
face global InlineInformation      rgb:c3ccdc,rgb:09243a
face global Error                  rgb:011627,rgb:ff5874
face global DiagnosticError        rgb:ff5874
face global DiagnosticWarning      rgb:f78c6c
face global StatusLine             rgb:c3ccdc,rgb:081e2f
face global StatusLineMode         rgb:c3ccdc+b
face global StatusLineInfo         rgb:c3ccdc
face global StatusLineValue        rgb:c3ccdc+b
face global StatusCursor           rgb:011627,rgb:82aaff
face global Prompt                 rgb:c792ea
