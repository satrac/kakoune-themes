# 10x-vs-plus-vax theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/VS+VAX.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:b5cea8
face global type          rgb:569cd6
face global variable      rgb:bdb76b
face global identifier    rgb:bdb76b
face global module        rgb:ffd700
face global function      rgb:ff8000
face global method        rgb:ff8000
face global string        rgb:d69d85
face global keyword       rgb:569cd6
face global operator      rgb:c8c8c8
face global attribute     rgb:72d8dc
face global comment       rgb:57a64a
face global documentation rgb:57a64a
face global meta          rgb:bd63c5
face global builtin       rgb:ffd700+b
face global constant      rgb:b5cea8
face global error         rgb:ffb4b4

# Markup
face global title  rgb:569cd6+b
face global header rgb:72d8dc
face global mono   rgb:848484
face global block  rgb:ffd700
face global link   rgb:569cd6+u
face global bullet rgb:e6e6be
face global list   rgb:c8c8c8

# UI
face global Default                rgb:c8c8c8,rgb:1e1e1e
face global PrimarySelection       rgb:1e1e1e,rgb:155096
face global SecondarySelection     rgb:c8c8c8,rgb:2a2a2a
face global PrimaryCursor          rgb:1e1e1e,rgb:c8c8c8+fg
face global SecondaryCursor        rgb:1e1e1e,rgb:848484+fg
face global PrimaryCursorEol       rgb:1e1e1e,rgb:c8c8c8+fg
face global SecondaryCursorEol     rgb:1e1e1e,rgb:2b91af+fg
face global MatchingChar           rgb:c8c8c8+b
face global MenuForeground         rgb:1e1e1e,rgb:569cd6
face global MenuBackground         rgb:c8c8c8,rgb:2d2d30
face global MenuInfo               rgb:569cd6
face global Information            rgb:1e1e1e,rgb:ffd370
face global InlineInformation      rgb:c8c8c8,rgb:2d2d30
face global Error                  rgb:1e1e1e,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:2d2d30
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:1e1e1e,rgb:c8c8c8
face global Prompt                 rgb:569cd6
face global BufferPadding          rgb:2b91af,rgb:1e1e1e
face global LineNumbers            rgb:2b91af,rgb:1e1e1e
face global LineNumberCursor       rgb:569cd6,rgb:1e1e1e+b
face global LineNumbersWrapped     rgb:2b91af,rgb:1e1e1e+i
face global Whitespace             rgb:515151+f
face global WrapMarker             rgb:515151+f
face global Search                 rgb:c8c8c8,rgb:5f2d00
face global DiffAdd                rgb:6fd85b,rgb:2e432a
face global DiffRm                 rgb:ffb4b4,rgb:4b3c3c
face global DiffMeta               rgb:569cd6,rgb:46463e
face global MercurialCommitComment rgb:57a64a

