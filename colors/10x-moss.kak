# 10x-moss theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Moss.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:c8c8c8
face global type          rgb:73bedc
face global variable      rgb:dce6dc
face global identifier    rgb:dce6dc
face global module        rgb:82dcf4
face global function      rgb:82aa82
face global method        rgb:95c590
face global string        rgb:c8d2dc
face global keyword       rgb:78a082
face global operator      rgb:c8c8c8
face global attribute     rgb:72d8dc
face global comment       rgb:46c846
face global documentation rgb:46c846
face global meta          rgb:aabe8c
face global builtin       rgb:82dcf4+b
face global constant      rgb:c8c8c8
face global error         rgb:ffb4b4

# Markup
face global title  rgb:78a082+b
face global header rgb:72d8dc
face global mono   rgb:7f8686
face global block  rgb:78b47d
face global link   rgb:78a082+u
face global bullet rgb:e6e6be
face global list   rgb:d0d0d0

# UI
face global Default                rgb:d0d0d0,rgb:051717
face global PrimarySelection       rgb:051717,rgb:32463c
face global SecondarySelection     rgb:d0d0d0,rgb:132424
face global PrimaryCursor          rgb:051717,rgb:ffffff+fg
face global SecondaryCursor        rgb:051717,rgb:7f8686+fg
face global PrimaryCursorEol       rgb:051717,rgb:ffffff+fg
face global SecondaryCursorEol     rgb:051717,rgb:646464+fg
face global MatchingChar           rgb:ffffff+b
face global MenuForeground         rgb:051717,rgb:78a082
face global MenuBackground         rgb:d0d0d0,rgb:142323
face global MenuInfo               rgb:78a082
face global Information            rgb:051717,rgb:ffd370
face global InlineInformation      rgb:d0d0d0,rgb:142323
face global Error                  rgb:051717,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:282f31
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:051717,rgb:ffffff
face global Prompt                 rgb:78a082
face global BufferPadding          rgb:646464,rgb:051717
face global LineNumbers            rgb:646464,rgb:051717
face global LineNumberCursor       rgb:78a082,rgb:051717+b
face global LineNumbersWrapped     rgb:646464,rgb:051717+i
face global Whitespace             rgb:424e4e+f
face global WrapMarker             rgb:424e4e+f
face global Search                 rgb:000000,rgb:464c23
