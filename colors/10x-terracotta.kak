face global SecondarySelection     rgb:e6dccd,rgb:37281f
face global PrimaryCursor          rgb:2a1a12,rgb:e6963c+fg
face global SecondaryCursor        rgb:2a1a12,rgb:9b8e82+fg
face global PrimaryCursorEol       rgb:2a1a12,rgb:e6963c+fg
face global SecondaryCursorEol     rgb:2a1a12,rgb:826955+fg
face global MatchingChar           rgb:e6963c+b
face global MenuForeground         rgb:2a1a12,rgb:e6c35a
face global MenuBackground         rgb:e6dccd,rgb:826450
face global MenuInfo               rgb:e6c35a
face global Information            rgb:2a1a12,rgb:e1b969
face global InlineInformation      rgb:e6dccd,rgb:826450
face global Error                  rgb:2a1a12,rgb:cdcd5a
face global DiagnosticError        rgb:cdcd5a
face global DiagnosticWarning      rgb:d2cdaf
face global StatusLine             rgb:faf0e1,rgb:78461e
face global StatusLineMode         rgb:faf0e1+b
face global StatusLineInfo         rgb:faf0e1
