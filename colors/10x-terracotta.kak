# 10x-terracotta theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Terracotta.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:d2af6e
face global type          rgb:6ec3c3
face global variable      rgb:dcd2c3
face global identifier    rgb:dcd2c3
face global module        rgb:f5d764
face global function      rgb:96bee6
face global method        rgb:8cafd7
face global string        rgb:8cbe78
face global keyword       rgb:dc8c46
face global operator      rgb:be8c78
face global attribute     rgb:64bec3
face global comment       rgb:968269
face global documentation rgb:a08c6e
face global meta          rgb:cdbe96
face global builtin       rgb:f5d764+b
face global constant      rgb:d2af6e
face global error         rgb:cdcd5a

# Markup
face global title  rgb:e6c35a+b
face global header rgb:64bec3
face global mono   rgb:9b8e82
face global block  rgb:d2eb8c
face global link   rgb:e6c35a+u
face global bullet rgb:d2cdaf
face global list   rgb:e6dccd

# UI
face global Default                rgb:e6dccd,rgb:2a1a12
