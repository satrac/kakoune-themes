# vscode-red theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/vscode-red.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:ffaaaa
face global type          rgb:ffc9c9
face global variable      rgb:f8f8f8
face global identifier    rgb:f8f8f8
face global module        rgb:ffc9c9
face global function      rgb:ffd0aa
face global method        rgb:ffd0aa
face global string        rgb:ce9178
face global keyword       rgb:ff7778+b
face global operator      rgb:e0999a
face global attribute     rgb:82aaff
face global comment       rgb:a8766c+i
face global documentation rgb:bc968f
face global meta          rgb:ff7778
face global builtin       rgb:ff7778+b
face global constant      rgb:ffaaaa
face global error         rgb:ff5555

# Markup
face global title  rgb:ff7778+b
face global header rgb:82aaff
face global mono   rgb:cf9090
face global block  rgb:ff7778
face global link   rgb:ff7778+u
face global bullet rgb:ffd75f
face global list   rgb:f8f8f8

# UI
face global Default                rgb:f8f8f8,rgb:390000
face global PrimarySelection       rgb:390000,rgb:750000
face global SecondarySelection     rgb:f8f8f8,rgb:4c1919
face global PrimaryCursor          rgb:390000,rgb:ff5555+fg
face global SecondaryCursor        rgb:390000,rgb:cf9090+fg
face global PrimaryCursorEol       rgb:390000,rgb:ff5555+fg
face global SecondaryCursorEol     rgb:390000,rgb:9e5252+fg
face global MatchingChar           rgb:ff5555+b
face global MenuForeground         rgb:390000,rgb:ff7778
face global MenuBackground         rgb:f8f8f8,rgb:3f0000
face global MenuInfo               rgb:ff7778
face global Information            rgb:390000,rgb:ffd75f
face global InlineInformation      rgb:f8f8f8,rgb:3f0000
face global Error                  rgb:390000,rgb:ff5555
face global DiagnosticError        rgb:ff5555
face global DiagnosticWarning      rgb:ffd75f
face global StatusLine             rgb:ffffff,rgb:700000
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:390000,rgb:ff5555
face global Prompt                 rgb:ff7778
face global BufferPadding          rgb:8f7070,rgb:390000
face global LineNumbers            rgb:9e5252,rgb:390000
face global LineNumberCursor       rgb:ff7778,rgb:390000+b
face global LineNumbersWrapped     rgb:9e5252,rgb:390000+i
face global Whitespace             rgb:540000+f
face global WrapMarker             rgb:540000+f
face global Search                 rgb:f8f8f8,rgb:991111
face global DiffAdd                rgb:56d4dd,rgb:43140c
face global DiffRm                 rgb:ff5555,rgb:4d0909
face global DiffMeta               rgb:ff7778,rgb:4d160a
face global MercurialCommitComment rgb:a8766c

