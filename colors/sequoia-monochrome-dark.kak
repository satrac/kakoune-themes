face global SecondarySelection     rgb:868690,rgb:1b1c20
face global PrimaryCursor          rgb:0f1014,rgb:7c829d+fg
face global SecondaryCursor        rgb:0f1014,rgb:575861+fg
face global PrimaryCursorEol       rgb:0f1014,rgb:7c829d+fg
face global SecondaryCursorEol     rgb:0f1014,rgb:575861+fg
face global MatchingChar           rgb:b6bac8+b
face global MenuForeground         rgb:0f1014,rgb:626983
face global MenuBackground         rgb:868690,rgb:111216
face global MenuInfo               rgb:626983
face global Information            rgb:0f1014,rgb:d3d5de
face global InlineInformation      rgb:868690,rgb:111216
face global Error                  rgb:0f1014,rgb:999eb2
face global DiagnosticError        rgb:999eb2
face global DiagnosticWarning      rgb:d3d5de
face global StatusLine             rgb:575861,rgb:0f1014
face global StatusLineMode         rgb:575861+b
face global StatusLineInfo         rgb:575861
face global StatusLineValue        rgb:575861+b
face global StatusCursor           rgb:0f1014,rgb:7c829d
face global Prompt                 rgb:626983
face global BufferPadding          rgb:45454c,rgb:0f1014
