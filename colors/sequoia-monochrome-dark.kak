# sequoia-monochrome-dark theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/sequoia-monochrome-dark.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:626983
face global type          rgb:7c829d
face global variable      rgb:b6bac8
face global identifier    rgb:b6bac8
face global module        rgb:7c829d
face global function      rgb:999eb2
face global method        rgb:999eb2
face global string        rgb:d3d5de
face global keyword       rgb:626983
face global operator      rgb:575861
face global attribute     rgb:7c829d
face global comment       rgb:43444d+i
face global documentation rgb:54545e
face global meta          rgb:e2e4ed
face global builtin       rgb:e2e4ed+b
face global constant      rgb:626983
face global error         rgb:999eb2

# Markup
face global title  rgb:626983+b
face global header rgb:7c829d
face global mono   rgb:575861
face global block  rgb:626983
face global link   rgb:626983+u
face global bullet rgb:d3d5de
face global list   rgb:868690

# UI
face global Default                rgb:868690,rgb:0f1014
