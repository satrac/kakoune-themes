# 10x-github-dark theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/GithubDark.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:79c0ff
face global type          rgb:ffa657
face global variable      rgb:e6edf3
face global identifier    rgb:e6edf3
face global module        rgb:ffa657
face global function      rgb:d299ff
face global method        rgb:d299ff
face global string        rgb:a5d6ff
face global keyword       rgb:ff7b72
face global operator      rgb:c9d1d9
face global attribute     rgb:3fb950
face global comment       rgb:8b949e
face global documentation rgb:7fbf74
face global meta          rgb:ff7b72
face global builtin       rgb:ffa657+b
face global constant      rgb:79c0ff
face global error         rgb:ff7b72

# Markup
face global title  rgb:ff7b72+b
face global header rgb:3fb950
face global mono   rgb:8f959b
face global block  rgb:ffa657
face global link   rgb:ff7b72+u
face global bullet rgb:e5c166
face global list   rgb:e6edf3

# UI
face global Default                rgb:e6edf3,rgb:0d1117
face global PrimarySelection       rgb:0d1117,rgb:214678
face global SecondarySelection     rgb:e6edf3,rgb:1c2026
face global PrimaryCursor          rgb:0d1117,rgb:ffffff+fg
face global SecondaryCursor        rgb:0d1117,rgb:8f959b+fg
face global PrimaryCursorEol       rgb:0d1117,rgb:ffffff+fg
face global SecondaryCursorEol     rgb:0d1117,rgb:444c56+fg
face global MatchingChar           rgb:ffffff+b
face global MenuForeground         rgb:0d1117,rgb:ff7b72
face global MenuBackground         rgb:e6edf3,rgb:161b22
face global MenuInfo               rgb:ff7b72
face global Information            rgb:0d1117,rgb:a5d6ff
face global InlineInformation      rgb:e6edf3,rgb:161b22
face global Error                  rgb:0d1117,rgb:ff7b72
face global DiagnosticError        rgb:ff7b72
face global DiagnosticWarning      rgb:e5c166
face global StatusLine             rgb:c9d1d9,rgb:161b22
face global StatusLineMode         rgb:c9d1d9+b
face global StatusLineInfo         rgb:c9d1d9
face global StatusLineValue        rgb:c9d1d9+b
face global StatusCursor           rgb:0d1117,rgb:ffffff
face global Prompt                 rgb:ff7b72
face global BufferPadding          rgb:444c56,rgb:0d1117
face global LineNumbers            rgb:444c56,rgb:0d1117
face global LineNumberCursor       rgb:ff7b72,rgb:0d1117+b
face global LineNumbersWrapped     rgb:444c56,rgb:0d1117+i
face global Whitespace             rgb:30363d+f
face global WrapMarker             rgb:30363d+f
face global Search                 rgb:e6edf3,rgb:624600
face global DiffAdd                rgb:7fbf74,rgb:24342a
face global DiffRm                 rgb:ff7b72,rgb:3d2629
face global DiffMeta               rgb:ff7b72,rgb:383427
face global MercurialCommitComment rgb:8b949e

