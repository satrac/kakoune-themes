# miniwinter-light theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/miniwinter-light-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:4f0b46
face global type          rgb:312e29
face global variable      rgb:312e29
face global identifier    rgb:312e29
face global module        rgb:312e29
face global function      rgb:014772
face global method        rgb:014772
face global string        rgb:00562e
face global keyword       rgb:312e29+i
face global operator      rgb:312e29
face global attribute     rgb:301d65
face global comment       rgb:6a6661+i
face global documentation rgb:6a6661
face global meta          rgb:301d65
face global builtin       rgb:016d71+b
face global constant      rgb:4f0b46
face global error         rgb:5c0113

# Markup
face global title  rgb:014772+b
face global header rgb:301d65
face global mono   rgb:757775
face global block  rgb:301d65
face global link   rgb:014772+u
face global bullet rgb:565600
face global list   rgb:312e29

# UI
face global Default                rgb:312e29,rgb:dce4e8
face global PrimarySelection       rgb:dce4e8,rgb:bcc4c8
face global SecondarySelection     rgb:312e29,rgb:e1e8eb
face global PrimaryCursor          rgb:dce4e8,rgb:014772+fg
face global SecondaryCursor        rgb:dce4e8,rgb:757775+fg
face global PrimaryCursorEol       rgb:dce4e8,rgb:014772+fg
face global SecondaryCursorEol     rgb:dce4e8,rgb:9ca4a7+fg
face global MatchingChar           rgb:014772+b
face global MenuForeground         rgb:dce4e8,rgb:014772
face global MenuBackground         rgb:312e29,rgb:e5edf1
face global MenuInfo               rgb:014772
face global Information            rgb:dce4e8,rgb:565600
face global InlineInformation      rgb:312e29,rgb:e5edf1
face global Error                  rgb:dce4e8,rgb:5c0113
face global DiagnosticError        rgb:5c0113
face global DiagnosticWarning      rgb:565600
face global StatusLine             rgb:0f2b3d,rgb:90ceff
face global StatusLineMode         rgb:0f2b3d+b
face global StatusLineInfo         rgb:0f2b3d
face global StatusLineValue        rgb:0f2b3d+b
face global StatusCursor           rgb:dce4e8,rgb:014772
face global Prompt                 rgb:014772
face global BufferPadding          rgb:868988,rgb:dce4e8
face global LineNumbers            rgb:9ca4a7,rgb:dce4e8
face global LineNumberCursor       rgb:014772,rgb:dce4e8+b
face global LineNumbersWrapped     rgb:9ca4a7,rgb:dce4e8+i
face global Whitespace             rgb:a0a4a5+f
face global WrapMarker             rgb:a0a4a5+f
face global Search                 rgb:312e29,rgb:929674
face global DiffAdd                rgb:014772,rgb:9ab5c5
face global DiffRm                 rgb:5c0113,rgb:b6a0a8
face global DiffMeta               rgb:014772,rgb:b4b9a2
face global MercurialCommitComment rgb:6a6661

