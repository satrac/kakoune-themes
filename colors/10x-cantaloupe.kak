# 10x-cantaloupe theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Cantaloupe.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:f096be
face global type          rgb:80a2ec
face global variable      rgb:adeb96
face global identifier    rgb:adeb96
face global module        rgb:f7bf78
face global function      rgb:c191ff
face global method        rgb:c191ff
face global string        rgb:66c3cc
face global keyword       rgb:80a2ec
face global operator      rgb:c8c8c8
face global attribute     rgb:72d8dc
face global comment       rgb:909090
face global documentation rgb:909090
face global meta          rgb:ee7357
face global builtin       rgb:f7bf78+b
face global constant      rgb:f096be
face global error         rgb:ffb4b4

# Markup
face global title  rgb:80a2ec+b
face global header rgb:72d8dc
face global mono   rgb:8c8c8c
face global block  rgb:ffd49e
face global link   rgb:80a2ec+u
face global bullet rgb:e6e6be
face global list   rgb:d0d0d0

# UI
face global Default                rgb:d0d0d0,rgb:262626
face global PrimarySelection       rgb:262626,rgb:0a3c64
face global SecondarySelection     rgb:d0d0d0,rgb:323232
face global PrimaryCursor          rgb:262626,rgb:d0d0d0+fg
face global SecondaryCursor        rgb:262626,rgb:8c8c8c+fg
face global PrimaryCursorEol       rgb:262626,rgb:d0d0d0+fg
face global SecondaryCursorEol     rgb:262626,rgb:2b91af+fg
face global MatchingChar           rgb:d0d0d0+b
face global MenuForeground         rgb:262626,rgb:80a2ec
face global MenuBackground         rgb:d0d0d0,rgb:302f2d
face global MenuInfo               rgb:80a2ec
face global Information            rgb:262626,rgb:ffd370
face global InlineInformation      rgb:d0d0d0,rgb:302f2d
face global Error                  rgb:262626,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:302f2d
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:262626,rgb:d0d0d0
face global Prompt                 rgb:80a2ec
face global BufferPadding          rgb:2b91af,rgb:262626
face global LineNumbers            rgb:2b91af,rgb:262626
face global LineNumberCursor       rgb:80a2ec,rgb:262626+b
face global LineNumbersWrapped     rgb:2b91af,rgb:262626+i
face global Whitespace             rgb:595959+f
face global WrapMarker             rgb:595959+f
face global Search                 rgb:d0d0d0,rgb:5f2d00
face global DiffAdd                rgb:6fd85b,rgb:354a31
face global DiffRm                 rgb:ffb4b4,rgb:514242
face global DiffMeta               rgb:80a2ec,rgb:4c4c44
face global MercurialCommitComment rgb:909090

