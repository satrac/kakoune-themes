# 10x-moriarty theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Moriarty.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:ffda82
face global type          rgb:ffda82
face global variable      rgb:fffbf5
face global identifier    rgb:fffbf5
face global module        rgb:ffda82
face global function      rgb:ffe8c7
face global method        rgb:ffe8c7
face global string        rgb:ffda82
face global keyword       rgb:ffcc99
face global operator      rgb:faf7f0
face global attribute     rgb:dcae72
face global comment       rgb:969696
face global documentation rgb:969696
face global meta          rgb:e69f73
face global builtin       rgb:ffda82+b
face global constant      rgb:ffda82
face global error         rgb:ffb4b4

# Markup
face global title  rgb:ffcc99+b
face global header rgb:dcae72
face global mono   rgb:6b6a6a
face global block  rgb:ffda82
face global link   rgb:ffcc99+u
face global bullet rgb:e6e6be
face global list   rgb:969696

# UI
face global Default                rgb:969696,rgb:2b2927
face global PrimarySelection       rgb:2b2927,rgb:dcb95a
face global SecondarySelection     rgb:969696,rgb:32312f
face global PrimaryCursor          rgb:2b2927,rgb:ffffc8+fg
face global SecondaryCursor        rgb:2b2927,rgb:6b6a6a+fg
face global PrimaryCursorEol       rgb:2b2927,rgb:ffffc8+fg
face global SecondaryCursorEol     rgb:2b2927,rgb:646464+fg
face global MatchingChar           rgb:ffffc8+b
face global MenuForeground         rgb:2b2927,rgb:ffcc99
face global MenuBackground         rgb:969696,rgb:231e14
face global MenuInfo               rgb:ffcc99
face global Information            rgb:2b2927,rgb:ffd370
face global InlineInformation      rgb:969696,rgb:231e14
face global Error                  rgb:2b2927,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:2f2d28
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:2b2927,rgb:ffffc8
face global Prompt                 rgb:ffcc99
face global BufferPadding          rgb:646464,rgb:2b2927
face global LineNumbers            rgb:646464,rgb:2b2927
face global LineNumberCursor       rgb:ffcc99,rgb:2b2927+b
face global LineNumbersWrapped     rgb:646464,rgb:2b2927+i
face global Whitespace             rgb:4b4a48+f
face global WrapMarker             rgb:4b4a48+f
face global Search                 rgb:000000,rgb:5f5819
face global DiffAdd                rgb:d8aa5b,rgb:4e4331
face global DiffRm                 rgb:ffb4b4,rgb:554543
face global DiffMeta               rgb:ffcc99,rgb:504f45
face global MercurialCommitComment rgb:969696

