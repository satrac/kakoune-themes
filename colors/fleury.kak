# fleury theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/fleury.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:ffa900
face global type          rgb:edb211
face global variable      rgb:b99468
face global identifier    rgb:b99468
face global module        rgb:edb211
face global function      rgb:de451f
face global method        rgb:de451f
face global string        rgb:ffa900
face global keyword       rgb:f0c674
face global operator      rgb:bd2d2d
face global attribute     rgb:2895c7
face global comment       rgb:666666+i
face global documentation rgb:7b7266
face global meta          rgb:f0c674
face global builtin       rgb:f0c674+b
face global constant      rgb:ffa900
face global error         rgb:ff0000

# Markup
face global title  rgb:f0c674+b
face global header rgb:2895c7
face global mono   rgb:666666
face global block  rgb:f0c674
face global link   rgb:f0c674+u
face global bullet rgb:ffae00
face global list   rgb:b99468

# UI
face global Default                rgb:b99468,rgb:020202
face global PrimarySelection       rgb:020202,rgb:303040
face global SecondarySelection     rgb:b99468,rgb:14110c
face global PrimaryCursor          rgb:020202,rgb:fcaa05+fg
face global SecondaryCursor        rgb:020202,rgb:666666+fg
face global PrimaryCursorEol       rgb:020202,rgb:fcaa05+fg
face global SecondaryCursorEol     rgb:020202,rgb:404040+fg
face global MatchingChar           rgb:fcaa05+b
face global MenuForeground         rgb:020202,rgb:f0c674
face global MenuBackground         rgb:b99468,rgb:101010
face global MenuInfo               rgb:f0c674
face global Information            rgb:020202,rgb:ffae00
face global InlineInformation      rgb:b99468,rgb:101010
face global Error                  rgb:020202,rgb:ff0000
face global DiagnosticError        rgb:ff0000
face global DiagnosticWarning      rgb:ffae00
face global StatusLine             rgb:ffffff,rgb:222425
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:020202,rgb:fcaa05
face global Prompt                 rgb:f0c674
face global BufferPadding          rgb:544430,rgb:020202
face global LineNumbers            rgb:404040,rgb:020202
face global LineNumberCursor       rgb:f0c674,rgb:020202+b
face global LineNumbersWrapped     rgb:404040,rgb:020202+i
face global Whitespace             rgb:404040+f
face global WrapMarker             rgb:404040+f
face global Search                 rgb:020202,rgb:494949
face global DiffAdd                rgb:8ffff2,rgb:0f2a0f
face global DiffRm                 rgb:ff0000,rgb:3a0000
face global DiffMeta               rgb:f0c674,rgb:2a230f
face global MercurialCommitComment rgb:666666

