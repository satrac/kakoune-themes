# 10x-material-dark theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Material-dark.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:eb7669
face global type          rgb:ffcb6b
face global variable      rgb:bedcfa
face global identifier    rgb:bedcfa
face global module        rgb:ffcb6b
face global function      rgb:6aaafb
face global method        rgb:6aaafb
face global string        rgb:9bdd8d
face global keyword       rgb:569cd6
face global operator      rgb:c8c8c8
face global attribute     rgb:72d8dc
face global comment       rgb:546e78
face global documentation rgb:546e78
face global meta          rgb:b3ffc0
face global builtin       rgb:ffcb6b+b
face global constant      rgb:eb7669
face global error         rgb:ffb4b4

# Markup
face global title  rgb:569cd6+b
face global header rgb:72d8dc
face global mono   rgb:8a9399
face global block  rgb:dcc864
face global link   rgb:569cd6+u
face global bullet rgb:e6e6be
face global list   rgb:cdd3da

# UI
face global Default                rgb:cdd3da,rgb:263238
face global PrimarySelection       rgb:263238,rgb:155096
face global SecondarySelection     rgb:cdd3da,rgb:323d43
face global PrimaryCursor          rgb:263238,rgb:cdd3da+fg
face global SecondaryCursor        rgb:263238,rgb:8a9399+fg
face global PrimaryCursorEol       rgb:263238,rgb:cdd3da+fg
face global SecondaryCursorEol     rgb:263238,rgb:37474f+fg
face global MatchingChar           rgb:cdd3da+b
face global MenuForeground         rgb:263238,rgb:569cd6
face global MenuBackground         rgb:cdd3da,rgb:2d2d30
face global MenuInfo               rgb:569cd6
face global Information            rgb:263238,rgb:ffd370
face global InlineInformation      rgb:cdd3da,rgb:2d2d30
face global Error                  rgb:263238,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:2d2d30
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:263238,rgb:cdd3da
face global Prompt                 rgb:569cd6
face global BufferPadding          rgb:37474f,rgb:263238
face global LineNumbers            rgb:37474f,rgb:263238
face global LineNumberCursor       rgb:569cd6,rgb:263238+b
face global LineNumbersWrapped     rgb:37474f,rgb:263238+i
face global Whitespace             rgb:586269+f
face global WrapMarker             rgb:586269+f
face global Search                 rgb:cdd3da,rgb:5f2d00
