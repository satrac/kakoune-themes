# 10x-spice theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Spice.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:d3869b
face global type          rgb:fabd2f
face global variable      rgb:fbf1c7
face global identifier    rgb:fbf1c7
face global module        rgb:fabd2f
face global function      rgb:b8bb26
face global method        rgb:b8bb26
face global string        rgb:b8bb26
face global keyword       rgb:fb4934
face global operator      rgb:c8c8c8
face global attribute     rgb:72d8dc
face global comment       rgb:928374
face global documentation rgb:928374
face global meta          rgb:b8bb26
face global builtin       rgb:fabd2f+b
face global constant      rgb:d3869b
face global error         rgb:ffb4b4

# Markup
face global title  rgb:fb4934+b
face global header rgb:72d8dc
face global mono   rgb:888888
face global block  rgb:83a598
face global link   rgb:fb4934+u
face global bullet rgb:e6e6be
face global list   rgb:c8c8c8

# UI
face global Default                rgb:c8c8c8,rgb:282828
face global PrimarySelection       rgb:282828,rgb:155096
face global SecondarySelection     rgb:c8c8c8,rgb:333333
face global PrimaryCursor          rgb:282828,rgb:c8c8c8+fg
face global SecondaryCursor        rgb:282828,rgb:888888+fg
face global PrimaryCursorEol       rgb:282828,rgb:c8c8c8+fg
face global SecondaryCursorEol     rgb:282828,rgb:fbf1c7+fg
face global MatchingChar           rgb:c8c8c8+b
face global MenuForeground         rgb:282828,rgb:fb4934
face global MenuBackground         rgb:c8c8c8,rgb:2d2d30
face global MenuInfo               rgb:fb4934
face global Information            rgb:282828,rgb:ffd370
face global InlineInformation      rgb:c8c8c8,rgb:2d2d30
face global Error                  rgb:282828,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:2d2d30
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:282828,rgb:c8c8c8
face global Prompt                 rgb:fb4934
face global BufferPadding          rgb:fbf1c7,rgb:282828
face global LineNumbers            rgb:fbf1c7,rgb:282828
face global LineNumberCursor       rgb:fb4934,rgb:282828+b
face global LineNumbersWrapped     rgb:fbf1c7,rgb:282828+i
face global Whitespace             rgb:585858+f
face global WrapMarker             rgb:585858+f
face global Search                 rgb:c8c8c8,rgb:5f2d00
