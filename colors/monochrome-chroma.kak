# monochrome-chroma theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/monochrome-chroma-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:c9e6fd
face global type          rgb:e0e2ea
face global variable      rgb:a6dbff
face global identifier    rgb:a6dbff
face global module        rgb:e0e2ea
face global function      rgb:8cf8f7
face global method        rgb:8cf8f7
face global string        rgb:b3f6c0
face global keyword       rgb:e0e2ea+i
face global operator      rgb:e0e2ea
face global attribute     rgb:8abae1
face global comment       rgb:9b9ea4+i
face global documentation rgb:9b9ea4
face global meta          rgb:a6dbff
face global builtin       rgb:ddfcf8+b
face global constant      rgb:e0e2ea
face global error         rgb:ec8989

# Markup
face global title  rgb:8abae1+b
face global header rgb:8abae1
face global mono   rgb:949494
face global block  rgb:a6dbff
face global link   rgb:8abae1+u
face global bullet rgb:ceb581
face global list   rgb:eeeeee

# UI
face global Default                rgb:eeeeee,rgb:0e0e0e
face global PrimarySelection       rgb:0e0e0e,rgb:56626b
face global SecondarySelection     rgb:eeeeee,rgb:191919
face global PrimaryCursor          rgb:0e0e0e,rgb:8abae1+fg
face global SecondaryCursor        rgb:0e0e0e,rgb:949494+fg
face global PrimaryCursorEol       rgb:0e0e0e,rgb:8abae1+fg
face global SecondaryCursorEol     rgb:0e0e0e,rgb:515151+fg
face global MatchingChar           rgb:8abae1+b
face global MenuForeground         rgb:0e0e0e,rgb:8abae1
face global MenuBackground         rgb:eeeeee,rgb:191919
face global MenuInfo               rgb:8abae1
face global Information            rgb:0e0e0e,rgb:ceb581
face global InlineInformation      rgb:eeeeee,rgb:191919
face global Error                  rgb:0e0e0e,rgb:ec8989
face global DiagnosticError        rgb:ec8989
face global DiagnosticWarning      rgb:ceb581
face global StatusLine             rgb:eeeeee,rgb:191919
face global StatusLineMode         rgb:eeeeee+b
face global StatusLineInfo         rgb:eeeeee
face global StatusLineValue        rgb:eeeeee+b
face global StatusCursor           rgb:0e0e0e,rgb:8abae1
face global Prompt                 rgb:8abae1
face global BufferPadding          rgb:515151,rgb:0e0e0e
face global LineNumbers            rgb:515151,rgb:0e0e0e
face global LineNumberCursor       rgb:8abae1,rgb:0e0e0e+b
face global LineNumbersWrapped     rgb:515151,rgb:0e0e0e+i
face global Whitespace             rgb:3f3f3f+f
face global WrapMarker             rgb:3f3f3f+f
face global Search                 rgb:eeeeee,rgb:916d5f
face global DiffAdd                rgb:8cf8f7,rgb:345454
face global DiffRm                 rgb:ec8989,rgb:513333
face global DiffMeta               rgb:8abae1,rgb:484030
face global MercurialCommitComment rgb:9b9ea4

