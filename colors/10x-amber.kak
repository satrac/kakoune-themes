# 10x-amber theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Amber.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:e09e56
face global type          rgb:ffc100
face global variable      rgb:cdcbc3
face global identifier    rgb:cdcbc3
face global module        rgb:ffc100
face global function      rgb:ecc678
face global method        rgb:ecc678
face global string        rgb:b2be5c
face global keyword       rgb:ea6848
face global operator      rgb:a09e96
face global attribute     rgb:ffc100
face global comment       rgb:7ab048
face global documentation rgb:68983e
face global meta          rgb:e0a438
face global builtin       rgb:ffc100+b
face global constant      rgb:e09e56
face global error         rgb:dc826e

# Markup
face global title  rgb:ec9630+b
face global header rgb:ffc100
face global mono   rgb:71706a
face global block  rgb:ffc100
face global link   rgb:ec9630+u
face global bullet rgb:dcc164
face global list   rgb:afada5

# UI
face global Default                rgb:afada5,rgb:151412
face global PrimarySelection       rgb:151412,rgb:464228
face global SecondarySelection     rgb:afada5,rgb:201f1c
face global PrimaryCursor          rgb:151412,rgb:ffc100+fg
face global SecondaryCursor        rgb:151412,rgb:71706a+fg
face global PrimaryCursorEol       rgb:151412,rgb:ffc100+fg
face global SecondaryCursorEol     rgb:151412,rgb:5a5850+fg
face global MatchingChar           rgb:ffc100+b
face global MenuForeground         rgb:151412,rgb:ec9630
face global MenuBackground         rgb:afada5,rgb:181715
face global MenuInfo               rgb:ec9630
face global Information            rgb:151412,rgb:ecd696
face global InlineInformation      rgb:afada5,rgb:181715
face global Error                  rgb:151412,rgb:dc826e
face global DiagnosticError        rgb:dc826e
face global DiagnosticWarning      rgb:dcc164
face global StatusLine             rgb:e1d2a0,rgb:2a2822
face global StatusLineMode         rgb:e1d2a0+b
face global StatusLineInfo         rgb:e1d2a0
face global StatusLineValue        rgb:e1d2a0+b
face global StatusCursor           rgb:151412,rgb:ffc100
face global Prompt                 rgb:ec9630
face global BufferPadding          rgb:5a5850,rgb:151412
face global LineNumbers            rgb:5a5850,rgb:151412
face global LineNumberCursor       rgb:ec9630,rgb:151412+b
face global LineNumbersWrapped     rgb:5a5850,rgb:151412+i
face global Whitespace             rgb:43423e+f
face global WrapMarker             rgb:43423e+f
face global Search                 rgb:afada5,rgb:5a5014
face global DiffAdd                rgb:769860,rgb:282e22
face global DiffRm                 rgb:dc826e,rgb:3d2a24
face global DiffMeta               rgb:ec9630,rgb:3d3722
face global MercurialCommitComment rgb:7ab048

