# 10x-solarized-dark theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/SolarizedDark.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:2aa198
face global type          rgb:b58900
face global variable      rgb:eee8d5
face global identifier    rgb:eee8d5
face global module        rgb:b58900
face global function      rgb:46aeff
face global method        rgb:46aeff
face global string        rgb:2aa198
face global keyword       rgb:859900
face global operator      rgb:969696
face global attribute     rgb:72d8dc
face global comment       rgb:586e75
face global documentation rgb:586e75
face global meta          rgb:cb4b16
face global builtin       rgb:b58900+b
face global constant      rgb:2aa198
face global error         rgb:ff0000

# Markup
face global title  rgb:859900+b
face global header rgb:72d8dc
face global mono   rgb:98a59e
face global block  rgb:b58900
face global link   rgb:859900+u
face global bullet rgb:966432
face global list   rgb:fdf6e3

# UI
face global Default                rgb:fdf6e3,rgb:002b36
face global PrimarySelection       rgb:002b36,rgb:3f5e61
face global SecondarySelection     rgb:fdf6e3,rgb:123942
face global PrimaryCursor          rgb:002b36,rgb:dc322f+fg
face global SecondaryCursor        rgb:002b36,rgb:98a59e+fg
face global PrimaryCursorEol       rgb:002b36,rgb:dc322f+fg
face global SecondaryCursorEol     rgb:002b36,rgb:586e75+fg
face global MatchingChar           rgb:dc322f+b
face global MenuForeground         rgb:002b36,rgb:859900
face global MenuBackground         rgb:fdf6e3,rgb:002b36
face global MenuInfo               rgb:859900
face global Information            rgb:002b36,rgb:ffd370
face global InlineInformation      rgb:fdf6e3,rgb:002b36
face global Error                  rgb:002b36,rgb:ff0000
face global DiagnosticError        rgb:ff0000
face global DiagnosticWarning      rgb:966432
face global StatusLine             rgb:fdf6e3,rgb:002b36
face global StatusLineMode         rgb:fdf6e3+b
face global StatusLineInfo         rgb:fdf6e3
face global StatusLineValue        rgb:fdf6e3+b
face global StatusCursor           rgb:002b36,rgb:dc322f
face global Prompt                 rgb:859900
face global BufferPadding          rgb:586e75,rgb:002b36
face global LineNumbers            rgb:586e75,rgb:073642
face global LineNumberCursor       rgb:859900,rgb:073642+b
face global LineNumbersWrapped     rgb:586e75,rgb:073642+i
face global Whitespace             rgb:586e75+f
face global WrapMarker             rgb:586e75+f
face global Search                 rgb:fdf6e3,rgb:78322f
face global DiffAdd                rgb:6fd85b,rgb:164e3d
face global DiffRm                 rgb:ff0000,rgb:33222b
face global DiffMeta               rgb:859900,rgb:1e3635
face global MercurialCommitComment rgb:586e75

