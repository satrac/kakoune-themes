# minisummer-light theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/minisummer-light-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:370674
face global type          rgb:2c2e33
face global variable      rgb:2c2e33
face global identifier    rgb:2c2e33
face global module        rgb:2c2e33
face global function      rgb:007e87
face global method        rgb:007e87
face global string        rgb:636900
face global keyword       rgb:2c2e33+i
face global operator      rgb:2c2e33
face global attribute     rgb:004d84
face global comment       rgb:64666c+i
face global documentation rgb:64666c
face global meta          rgb:2c2e33
face global builtin       rgb:006f44+b
face global constant      rgb:370674
face global error         rgb:61004f

# Markup
face global title  rgb:804e00+b
face global header rgb:004d84
face global mono   rgb:787677
face global block  rgb:2c2e33
face global link   rgb:804e00+u
face global bullet rgb:804e00
face global list   rgb:2c2e33

# UI
face global Default                rgb:2c2e33,rgb:e9e1dd
face global PrimarySelection       rgb:e9e1dd,rgb:ac9c87
face global SecondarySelection     rgb:2c2e33,rgb:ece6e2
face global PrimaryCursor          rgb:e9e1dd,rgb:804e00+fg
face global SecondaryCursor        rgb:e9e1dd,rgb:787677+fg
face global PrimaryCursorEol       rgb:e9e1dd,rgb:804e00+fg
face global SecondaryCursorEol     rgb:e9e1dd,rgb:a8a19d+fg
face global MatchingChar           rgb:804e00+b
face global MenuForeground         rgb:e9e1dd,rgb:804e00
face global MenuBackground         rgb:2c2e33,rgb:f2eae6
face global MenuInfo               rgb:804e00
face global Information            rgb:e9e1dd,rgb:804e00
face global InlineInformation      rgb:2c2e33,rgb:f2eae6
face global Error                  rgb:e9e1dd,rgb:61004f
face global DiagnosticError        rgb:61004f
face global DiagnosticWarning      rgb:804e00
face global StatusLine             rgb:2c2e33,rgb:ffc888
face global StatusLineMode         rgb:2c2e33+b
face global StatusLineInfo         rgb:2c2e33
face global StatusLineValue        rgb:2c2e33+b
face global StatusCursor           rgb:e9e1dd,rgb:804e00
face global Prompt                 rgb:804e00
face global BufferPadding          rgb:8a8888,rgb:e9e1dd
face global LineNumbers            rgb:a8a19d,rgb:e9e1dd
face global LineNumberCursor       rgb:804e00,rgb:e9e1dd+b
face global LineNumbersWrapped     rgb:a8a19d,rgb:e9e1dd+i
face global Whitespace             rgb:a7a2a2+f
face global WrapMarker             rgb:a7a2a2+f
face global Search                 rgb:2c2e33,rgb:a89170
face global DiffAdd                rgb:007e87,rgb:a3c3c3
face global DiffRm                 rgb:61004f,rgb:c09eb2
face global DiffMeta               rgb:804e00,rgb:cab59b
face global MercurialCommitComment rgb:64666c

