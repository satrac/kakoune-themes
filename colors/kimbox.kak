# kimbox theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/kimbox.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:7eb2b1
face global type          rgb:819c3b
face global variable      rgb:d9ae80
face global identifier    rgb:d9ae80
face global module        rgb:819c3b
face global function      rgb:a06469
face global method        rgb:a06469
face global string        rgb:ff9500
face global keyword       rgb:ef1d55
face global operator      rgb:ff5813
face global attribute     rgb:4c96a8
face global comment       rgb:7e602c+i
face global documentation rgb:957441
face global meta          rgb:4c96a8
face global builtin       rgb:4c96a8+b
face global constant      rgb:7eb2b1
face global error         rgb:ef1d55

# Markup
face global title  rgb:ef1d55+b
face global header rgb:4c96a8
face global mono   rgb:c2a383
face global block  rgb:ef1d55
face global link   rgb:ef1d55+u
face global bullet rgb:ff9500
face global list   rgb:d9ae80

# UI
face global Default                rgb:d9ae80,rgb:221a02
face global PrimarySelection       rgb:221a02,rgb:572906
face global SecondarySelection     rgb:d9ae80,rgb:34290f
face global PrimaryCursor          rgb:221a02,rgb:ff5813+fg
face global SecondaryCursor        rgb:221a02,rgb:c2a383+fg
face global PrimaryCursorEol       rgb:221a02,rgb:ff5813+fg
face global SecondaryCursorEol     rgb:221a02,rgb:7e602c+fg
face global MatchingChar           rgb:ff5813+b
face global MenuForeground         rgb:221a02,rgb:ef1d55
face global MenuBackground         rgb:d9ae80,rgb:362712
face global MenuInfo               rgb:ef1d55
face global Information            rgb:221a02,rgb:ff9500
face global InlineInformation      rgb:d9ae80,rgb:362712
face global Error                  rgb:221a02,rgb:ef1d55
face global DiagnosticError        rgb:ef1d55
face global DiagnosticWarning      rgb:ff9500
face global StatusLine             rgb:ffffff,rgb:39260e
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:221a02,rgb:ff5813
face global Prompt                 rgb:ef1d55
face global BufferPadding          rgb:745d3b,rgb:221a02
face global LineNumbers            rgb:7e602c,rgb:221a02
face global LineNumberCursor       rgb:ef1d55,rgb:221a02+b
face global LineNumbersWrapped     rgb:7e602c,rgb:221a02+i
face global Whitespace             rgb:362712+f
face global WrapMarker             rgb:362712+f
face global Search                 rgb:ffffff,rgb:5f7191
