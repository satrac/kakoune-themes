# black-metal-gorgoroth-light theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/black-metal-gorgoroth-light-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:6d6d6d
face global type          rgb:655443
face global variable      rgb:242019
face global identifier    rgb:242019
face global module        rgb:655443
face global function      rgb:696969
face global method        rgb:696969
face global string        rgb:3b6213
face global keyword       rgb:6b6b6b+i
face global operator      rgb:6c6a76
face global attribute     rgb:3a6ea5
face global comment       rgb:6e685d+i
face global documentation rgb:6e685d
face global meta          rgb:3b6213
face global builtin       rgb:655443+b
face global constant      rgb:6d6d6d
face global error         rgb:a13b3b

# Markup
face global title  rgb:3b5959+b
face global header rgb:3a6ea5
face global mono   rgb:76736d
face global block  rgb:3b6213
face global link   rgb:3b5959+u
face global bullet rgb:8a6d1f
face global list   rgb:242019

# UI
face global Default                rgb:242019,rgb:f2f0ec
face global PrimarySelection       rgb:f2f0ec,rgb:d5d3ce
face global SecondarySelection     rgb:242019,rgb:f4f2ef
face global PrimaryCursor          rgb:f2f0ec,rgb:3b5959+fg
face global SecondaryCursor        rgb:f2f0ec,rgb:76736d+fg
face global PrimaryCursorEol       rgb:f2f0ec,rgb:3b5959+fg
face global SecondaryCursorEol     rgb:f2f0ec,rgb:b4b2ad+fg
face global MatchingChar           rgb:3b5959+b
face global MenuForeground         rgb:f2f0ec,rgb:3b5959
face global MenuBackground         rgb:242019,rgb:eceae6
face global MenuInfo               rgb:3b5959
face global Information            rgb:f2f0ec,rgb:8a6d1f
face global InlineInformation      rgb:242019,rgb:eceae6
face global Error                  rgb:f2f0ec,rgb:a13b3b
face global DiagnosticError        rgb:a13b3b
face global DiagnosticWarning      rgb:8a6d1f
face global StatusLine             rgb:242019,rgb:e8e6e1
face global StatusLineMode         rgb:242019+b
face global StatusLineInfo         rgb:242019
face global StatusLineValue        rgb:242019+b
face global StatusCursor           rgb:f2f0ec,rgb:3b5959
face global Prompt                 rgb:3b5959
face global BufferPadding          rgb:8b8882,rgb:f2f0ec
face global LineNumbers            rgb:b4b2ad,rgb:f2f0ec
face global LineNumberCursor       rgb:3b5959,rgb:f2f0ec+b
face global LineNumbersWrapped     rgb:b4b2ad,rgb:f2f0ec+i
face global Whitespace             rgb:aaa7a2+f
face global WrapMarker             rgb:aaa7a2+f
face global Search                 rgb:242019,rgb:9b9997
face global DiffAdd                rgb:696969,rgb:c9c8c5
face global DiffRm                 rgb:a13b3b,rgb:dabab7
face global DiffMeta               rgb:3b5959,rgb:d3c9ae
face global MercurialCommitComment rgb:6e685d

