# everforest theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/everforest.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:83c092
face global type          rgb:dbbc7f
face global variable      rgb:d3c6aa
face global identifier    rgb:d3c6aa
face global module        rgb:dbbc7f
face global function      rgb:a7c080
face global method        rgb:a7c080
face global string        rgb:a7c080
face global keyword       rgb:e67e80
face global operator      rgb:e69875
face global attribute     rgb:7fbbb3
face global comment       rgb:859289+i
face global documentation rgb:989f91
face global meta          rgb:d699b6
face global builtin       rgb:d699b6+b
face global constant      rgb:83c092
face global error         rgb:e67e80

# Markup
face global title  rgb:e67e80+b
face global header rgb:7fbbb3
face global mono   rgb:7a8478
face global block  rgb:e67e80
face global link   rgb:e67e80+u
face global bullet rgb:dbbc7f
face global list   rgb:d3c6aa

