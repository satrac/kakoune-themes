# miniwinter theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/miniwinter.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:edc7e7
face global type          rgb:d8d4cd
face global variable      rgb:d8d4cd
face global identifier    rgb:d8d4cd
face global module        rgb:d8d4cd
face global function      rgb:b3daf9
face global method        rgb:b3daf9
face global string        rgb:b8e1c1
face global keyword       rgb:d8d4cd+b
face global operator      rgb:d8d4cd
face global attribute     rgb:d1cffb
face global comment       rgb:98948e+i
face global documentation rgb:a8a49e
face global meta          rgb:a6e1e2
face global builtin       rgb:a6e1e2+b
face global constant      rgb:edc7e7
face global error         rgb:fac5c7

# Markup
face global title  rgb:d8d4cd+b
face global header rgb:d1cffb
face global mono   rgb:b8b4ad
face global block  rgb:d8d4cd
face global link   rgb:d8d4cd+u
face global bullet rgb:d9d8aa
face global list   rgb:d8d4cd

# UI
face global Default                rgb:d8d4cd,rgb:11262d
face global PrimarySelection       rgb:11262d,rgb:38515e
face global SecondarySelection     rgb:d8d4cd,rgb:25373d
face global PrimaryCursor          rgb:11262d,rgb:b3daf9+fg
face global SecondaryCursor        rgb:11262d,rgb:b8b4ad+fg
face global PrimaryCursorEol       rgb:11262d,rgb:b3daf9+fg
face global SecondaryCursorEol     rgb:11262d,rgb:485f67+fg
face global MatchingChar           rgb:b3daf9+b
face global MenuForeground         rgb:11262d,rgb:d8d4cd
face global MenuBackground         rgb:d8d4cd,rgb:051a20
face global MenuInfo               rgb:d8d4cd
face global Information            rgb:11262d,rgb:d9d8aa
face global InlineInformation      rgb:d8d4cd,rgb:051a20
face global Error                  rgb:11262d,rgb:fac5c7
face global DiagnosticError        rgb:fac5c7
face global DiagnosticWarning      rgb:d9d8aa
face global StatusLine             rgb:ffffff,rgb:00324f
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:11262d,rgb:b3daf9
face global Prompt                 rgb:d8d4cd
face global BufferPadding          rgb:6b7475,rgb:11262d
face global LineNumbers            rgb:485f67,rgb:11262d
face global LineNumberCursor       rgb:d8d4cd,rgb:11262d+b
face global LineNumbersWrapped     rgb:485f67,rgb:11262d+i
face global Whitespace             rgb:1c3139+f
face global WrapMarker             rgb:1c3139+f
face global Search                 rgb:ffffff,rgb:445e6d
face global DiffAdd                rgb:a6e1e2,rgb:0f272b
face global DiffRm                 rgb:fac5c7,rgb:16232a
face global DiffMeta               rgb:d8d4cd,rgb:152828
face global MercurialCommitComment rgb:98948e

