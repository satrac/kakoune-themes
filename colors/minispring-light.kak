# minispring-light theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/minispring-light-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:600051
face global type          rgb:2c2e33
face global variable      rgb:2c2e33
face global identifier    rgb:2c2e33
face global module        rgb:2c2e33
face global function      rgb:005085
face global method        rgb:005085
face global string        rgb:006d3f
face global keyword       rgb:2c2e33+i
face global operator      rgb:2c2e33
face global attribute     rgb:350775
face global comment       rgb:64666c+i
face global documentation rgb:64666c
face global meta          rgb:2c2e33
face global builtin       rgb:007f86+b
face global constant      rgb:600051
face global error         rgb:700015

# Markup
face global title  rgb:2e5e00+b
face global header rgb:350775
face global mono   rgb:747777
face global block  rgb:2c2e33
face global link   rgb:2e5e00+u
face global bullet rgb:676900
face global list   rgb:2c2e33

# UI
face global Default                rgb:2c2e33,rgb:e0e4de
face global PrimarySelection       rgb:e0e4de,rgb:93a188
face global SecondarySelection     rgb:2c2e33,rgb:e5e8e3
face global PrimaryCursor          rgb:e0e4de,rgb:2e5e00+fg
face global SecondaryCursor        rgb:e0e4de,rgb:747777+fg
face global PrimaryCursorEol       rgb:e0e4de,rgb:2e5e00+fg
face global SecondaryCursorEol     rgb:e0e4de,rgb:a0a39e+fg
face global MatchingChar           rgb:2e5e00+b
face global MenuForeground         rgb:e0e4de,rgb:2e5e00
face global MenuBackground         rgb:2c2e33,rgb:e9ede7
face global MenuInfo               rgb:2e5e00
face global Information            rgb:e0e4de,rgb:676900
face global InlineInformation      rgb:2c2e33,rgb:e9ede7
face global Error                  rgb:e0e4de,rgb:700015
face global DiagnosticError        rgb:700015
face global DiagnosticWarning      rgb:676900
face global StatusLine             rgb:2c2e33,rgb:80ffb8
face global StatusLineMode         rgb:2c2e33+b
face global StatusLineInfo         rgb:2c2e33
face global StatusLineValue        rgb:2c2e33+b
face global StatusCursor           rgb:e0e4de,rgb:2e5e00
face global Prompt                 rgb:2e5e00
face global BufferPadding          rgb:868988,rgb:e0e4de
face global LineNumbers            rgb:a0a39e,rgb:e0e4de
face global LineNumberCursor       rgb:2e5e00,rgb:e0e4de+b
face global LineNumbersWrapped     rgb:a0a39e,rgb:e0e4de+i
face global Whitespace             rgb:a1a4a2+f
face global WrapMarker             rgb:a1a4a2+f
face global Search                 rgb:2c2e33,rgb:9a9d71
face global DiffAdd                rgb:005085,rgb:9db8c3
face global DiffRm                 rgb:700015,rgb:bea0a2
face global DiffMeta               rgb:2e5e00,rgb:bcbf9b
face global MercurialCommitComment rgb:64666c

