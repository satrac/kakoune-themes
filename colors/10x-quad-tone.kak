# 10x-quad-tone theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Quad-Tone.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:34febb
face global type          rgb:dd9944
face global variable      rgb:88b4e7
face global identifier    rgb:88b4e7
face global module        rgb:32ae85
face global function      rgb:d6e9ff
face global method        rgb:d6e9ff
face global string        rgb:d6e9ff
face global keyword       rgb:88b4e7
face global operator      rgb:d6e9ff
face global attribute     rgb:d6e9ff
face global comment       rgb:586f89
face global documentation rgb:586f89
face global meta          rgb:88b4e7
face global builtin       rgb:32ae85+b
face global constant      rgb:34febb
face global error         rgb:ff6464

# Markup
face global title  rgb:88b4e7+b
face global header rgb:d6e9ff
face global mono   rgb:5b7694
face global block  rgb:d6e9ff
face global link   rgb:88b4e7+u
face global bullet rgb:dcdc00
face global list   rgb:88b4e7

# UI
face global Default                rgb:88b4e7,rgb:181818
face global PrimarySelection       rgb:181818,rgb:2e3b56
face global SecondarySelection     rgb:88b4e7,rgb:202326
face global PrimaryCursor          rgb:181818,rgb:ffffc8+fg
face global SecondaryCursor        rgb:181818,rgb:5b7694+fg
face global PrimaryCursorEol       rgb:181818,rgb:ffffc8+fg
face global SecondaryCursorEol     rgb:181818,rgb:586f89+fg
face global MatchingChar           rgb:ffffc8+b
face global MenuForeground         rgb:181818,rgb:88b4e7
face global MenuBackground         rgb:88b4e7,rgb:161619
face global MenuInfo               rgb:88b4e7
face global Information            rgb:181818,rgb:d6e9ff
face global InlineInformation      rgb:88b4e7,rgb:161619
face global Error                  rgb:181818,rgb:ff6464
face global DiagnosticError        rgb:ff6464
face global DiagnosticWarning      rgb:dcdc00
face global StatusLine             rgb:88b4e7,rgb:181818
face global StatusLineMode         rgb:88b4e7+b
face global StatusLineInfo         rgb:88b4e7
face global StatusLineValue        rgb:88b4e7+b
face global StatusCursor           rgb:181818,rgb:ffffc8
face global Prompt                 rgb:88b4e7
face global BufferPadding          rgb:586f89,rgb:181818
