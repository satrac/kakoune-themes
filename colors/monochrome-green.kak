# monochrome-green theme for Kakoune
#
# Ported from the justaperlhacker VS Code color theme (palettes/vscode/monochrome-green-color-theme.json).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:e0fce0
face global type          rgb:11ae0e
face global variable      rgb:84f581
face global identifier    rgb:84f581
face global module        rgb:11ae0e
face global function      rgb:2cee28
face global method        rgb:2cee28
face global string        rgb:b1f9af
face global keyword       rgb:11ae0e+i
face global operator      rgb:e0fce0
face global attribute     rgb:58f155
face global comment       rgb:0d870b+i
face global documentation rgb:0d870b
face global meta          rgb:58f155
face global builtin       rgb:b1f9af+b
face global constant      rgb:e0fce0
face global error         rgb:b1f9af

# Markup
face global title  rgb:84f581+b
face global header rgb:58f155
face global mono   rgb:88a287
face global block  rgb:58f155
face global link   rgb:84f581+u
face global bullet rgb:e0fce0
face global list   rgb:e0fce0

# UI
face global Default                rgb:e0fce0,rgb:031a02
face global PrimarySelection       rgb:031a02,rgb:4c794b
face global SecondarySelection     rgb:e0fce0,rgb:0e250d
face global PrimaryCursor          rgb:031a02,rgb:84f581+fg
face global SecondaryCursor        rgb:031a02,rgb:88a287+fg
face global PrimaryCursorEol       rgb:031a02,rgb:84f581+fg
face global SecondaryCursorEol     rgb:031a02,rgb:455e45+fg
face global MatchingChar           rgb:84f581+b
face global MenuForeground         rgb:031a02,rgb:84f581
face global MenuBackground         rgb:e0fce0,rgb:0e250d
face global MenuInfo               rgb:84f581
face global Information            rgb:031a02,rgb:e0fce0
face global InlineInformation      rgb:e0fce0,rgb:0e250d
face global Error                  rgb:031a02,rgb:b1f9af
face global DiagnosticError        rgb:b1f9af
face global DiagnosticWarning      rgb:e0fce0
face global StatusLine             rgb:e0fce0,rgb:0e250d
face global StatusLineMode         rgb:e0fce0+b
face global StatusLineInfo         rgb:e0fce0
face global StatusLineValue        rgb:e0fce0+b
face global StatusCursor           rgb:031a02,rgb:84f581
face global Prompt                 rgb:84f581
face global BufferPadding          rgb:455e45,rgb:031a02
face global LineNumbers            rgb:455e45,rgb:031a02
face global LineNumberCursor       rgb:84f581,rgb:031a02+b
face global LineNumbersWrapped     rgb:455e45,rgb:031a02+i
face global Whitespace             rgb:344c33+f
face global WrapMarker             rgb:344c33+f
face global Search                 rgb:e0fce0,rgb:70a06f
face global DiffAdd                rgb:2cee28,rgb:0f5a0d
face global DiffRm                 rgb:b1f9af,rgb:375d36
face global DiffMeta               rgb:84f581,rgb:455e45
face global MercurialCommitComment rgb:0d870b

