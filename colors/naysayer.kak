# naysayer theme for Kakoune
#
# Ported from p0209p/naysayer.vim (Neovim) and the justaperlhacker VS Code "naysayer" theme.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:7ad0c6
face global type          rgb:8cde94
face global variable      rgb:afc6ce
face global identifier    rgb:afc6ce
face global module        rgb:8cde94
face global function      rgb:d1b897
face global method        rgb:d1b897
face global string        rgb:22b59e
face global keyword       rgb:ffffff+i
face global operator      rgb:8cde94
face global attribute     rgb:7ad0c6
face global comment       rgb:43504a+i
face global documentation rgb:5a6b60
face global meta          rgb:7ad0c6
face global builtin       rgb:8cde94+b
face global constant      rgb:7ad0c6
face global error         rgb:c74138

# Markup
face global title  rgb:8cde94+b
face global header rgb:7ad0c6
face global mono   rgb:afc6ce
face global block  rgb:7ad0c6
face global link   rgb:8cde94+u
face global bullet rgb:ffaa00
face global list   rgb:d1b897

# UI
face global Default                rgb:d1b897,rgb:062329
face global PrimarySelection       rgb:062329,rgb:2e5b49
face global SecondarySelection     rgb:d1b897,rgb:102a2f
face global PrimaryCursor          rgb:062329,rgb:8cde94+fg
face global SecondaryCursor        rgb:062329,rgb:afc6ce+fg
face global PrimaryCursorEol       rgb:062329,rgb:8cde94+fg
face global SecondaryCursorEol     rgb:062329,rgb:9e937c+fg
face global MatchingChar           rgb:8cde94+b
face global MenuForeground         rgb:062329,rgb:8cde94
face global MenuBackground         rgb:d1b897,rgb:102a2f
face global MenuInfo               rgb:8cde94
face global Information            rgb:062329,rgb:ffaa00
face global InlineInformation      rgb:d1b897,rgb:102a2f
face global Error                  rgb:062329,rgb:c74138
face global DiagnosticError        rgb:c74138
face global DiagnosticWarning      rgb:ffaa00
face global StatusLine             rgb:d1b897,rgb:102a2f
face global StatusLineMode         rgb:d1b897+b
face global StatusLineInfo         rgb:d1b897
face global StatusLineValue        rgb:d1b897+b
face global StatusCursor           rgb:062329,rgb:8cde94
face global Prompt                 rgb:8cde94
face global BufferPadding          rgb:43504a,rgb:062329
face global LineNumbers            rgb:9e937c,rgb:062329
face global LineNumberCursor       rgb:8cde94,rgb:062329+b
face global LineNumbersWrapped     rgb:9e937c,rgb:062329+i
face global Whitespace             rgb:334441+f
face global WrapMarker             rgb:334441+f
face global Search                 rgb:062329,rgb:8cde94
face global DiffAdd                rgb:22b59e,rgb:0e4c4a
face global DiffRm                 rgb:c74138,rgb:3a1512
face global DiffMeta               rgb:8cde94,rgb:3d4120
face global MercurialCommitComment rgb:43504a

