# minispring theme for Kakoune
#
# Ported from Neovim's mini.hues palette (palettes/mini/minispring.lua).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:f7c2ea
face global type          rgb:d2d5db
face global variable      rgb:d8da9d
face global identifier    rgb:d8da9d
face global module        rgb:94e5ea
face global function      rgb:a9d8ff
face global method        rgb:a9d8ff
face global string        rgb:abe5be
face global keyword       rgb:d2d5db
face global operator      rgb:d2d5db
face global attribute     rgb:94e5ea
face global comment       rgb:92959b+i
face global documentation rgb:92959b
face global meta          rgb:f7c2ea
face global builtin       rgb:a9d8ff+b
face global constant      rgb:f7c2ea
face global error         rgb:ffc1bf

# Markup
face global title  rgb:bee2ad+b
face global header rgb:94e5ea
face global mono   rgb:b2b5bb
face global block  rgb:f7c2ea
face global link   rgb:bee2ad+u
face global bullet rgb:d8da9d
face global list   rgb:d2d5db

# UI
face global Default                rgb:d2d5db,rgb:1c2617
face global PrimarySelection       rgb:1c2617,rgb:535f4d
face global SecondarySelection     rgb:d2d5db,rgb:374231
face global PrimaryCursor          rgb:1c2617,rgb:bee2ad+fg
face global SecondaryCursor        rgb:1c2617,rgb:b2b5bb+fg
face global PrimaryCursorEol       rgb:1c2617,rgb:bee2ad+fg
face global SecondaryCursorEol     rgb:1c2617,rgb:535f4d+fg
face global MatchingChar           rgb:bee2ad+b
face global MenuForeground         rgb:1c2617,rgb:bee2ad
face global MenuBackground         rgb:d2d5db,rgb:101a0b
face global MenuInfo               rgb:bee2ad
face global Information            rgb:1c2617,rgb:d8da9d
face global InlineInformation      rgb:d2d5db,rgb:101a0b
face global Error                  rgb:1c2617,rgb:ffc1bf
face global DiagnosticError        rgb:ffc1bf
face global DiagnosticWarning      rgb:d8da9d
face global StatusLine             rgb:b2b5bb,rgb:00381d
face global StatusLineMode         rgb:b2b5bb+b
face global StatusLineInfo         rgb:b2b5bb
face global StatusLineValue        rgb:b2b5bb+b
face global StatusCursor           rgb:1c2617,rgb:bee2ad
face global Prompt                 rgb:bee2ad
face global BufferPadding          rgb:b2b5bb,rgb:1c2617
face global LineNumbers            rgb:535f4d,rgb:1c2617
face global LineNumberCursor       rgb:bee2ad,rgb:1c2617+b
face global LineNumbersWrapped     rgb:535f4d,rgb:1c2617+i
face global Whitespace             rgb:92959b+f
face global WrapMarker             rgb:92959b+f
face global Search                 rgb:1c2617,rgb:bee2ad
face global DiffAdd                rgb:abe5be,rgb:00381d
face global DiffRm                 rgb:ffc1bf,rgb:410d12
face global DiffMeta               rgb:bee2ad,rgb:004c4f
face global MercurialCommitComment rgb:92959b

