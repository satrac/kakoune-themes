# 10x-orange theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Orange.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:c8c8c8
face global type          rgb:00ffff
face global variable      rgb:c8b4a0
face global identifier    rgb:c8b4a0
face global module        rgb:ffc814
face global function      rgb:ff9600
face global method        rgb:ff9600
face global string        rgb:c8d2d2
face global keyword       rgb:ff8000
face global operator      rgb:ffffff
face global attribute     rgb:72d8dc
face global comment       rgb:1e64c8
face global documentation rgb:1e64c8
face global meta          rgb:967846
face global builtin       rgb:ffc814+b
face global constant      rgb:c8c8c8
face global error         rgb:ffb4b4

# Markup
face global title  rgb:ff8000+b
face global header rgb:72d8dc
face global mono   rgb:a3a3a3
face global block  rgb:dcc800
face global link   rgb:ff8000+u
face global bullet rgb:e6e6be
face global list   rgb:ffffff

# UI
face global Default                rgb:ffffff,rgb:181818
face global PrimarySelection       rgb:181818,rgb:46506e
face global SecondarySelection     rgb:ffffff,rgb:282828
face global PrimaryCursor          rgb:181818,rgb:ffffff+fg
face global SecondaryCursor        rgb:181818,rgb:a3a3a3+fg
face global PrimaryCursorEol       rgb:181818,rgb:ffffff+fg
face global SecondaryCursorEol     rgb:181818,rgb:747474+fg
face global MatchingChar           rgb:ffffff+b
face global MenuForeground         rgb:181818,rgb:ff8000
face global MenuBackground         rgb:ffffff,rgb:141412
face global MenuInfo               rgb:ff8000
face global Information            rgb:181818,rgb:ffd370
face global InlineInformation      rgb:ffffff,rgb:141412
face global Error                  rgb:181818,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:141412
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:181818,rgb:ffffff
face global Prompt                 rgb:ff8000
face global BufferPadding          rgb:747474,rgb:181818
face global LineNumbers            rgb:747474,rgb:181818
face global LineNumberCursor       rgb:ff8000,rgb:181818+b
face global LineNumbersWrapped     rgb:747474,rgb:181818+i
face global Whitespace             rgb:5d5d5d+f
face global WrapMarker             rgb:5d5d5d+f
face global Search                 rgb:ffffff,rgb:5f2d00
face global DiffAdd                rgb:6fd85b,rgb:293e25
face global DiffRm                 rgb:ffb4b4,rgb:463737
face global DiffMeta               rgb:ff8000,rgb:414139
face global MercurialCommitComment rgb:1e64c8

