# 10x-mono-grey theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/MonoGrey.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:ffffff
face global type          rgb:ffffff
face global variable      rgb:ffffff
face global identifier    rgb:ffffff
face global module        rgb:ffffff
face global function      rgb:ffffff
face global method        rgb:ffffff
face global string        rgb:ffffff
face global keyword       rgb:ffffff
face global operator      rgb:ffffff
face global attribute     rgb:ffffff
face global comment       rgb:ffffff
face global documentation rgb:ffffff
face global meta          rgb:ffffff
face global builtin       rgb:ffffff+b
face global constant      rgb:ffffff
face global error         rgb:ffb4b4

# Markup
face global title  rgb:ffffff+b
face global header rgb:ffffff
face global mono   rgb:b2b2b2
face global block  rgb:ffffff
face global link   rgb:ffffff+u
face global bullet rgb:e6e6be
face global list   rgb:ffffff

# UI
face global Default                rgb:ffffff,rgb:3f3f3f
face global PrimarySelection       rgb:3f3f3f,rgb:dcdc5a
face global SecondarySelection     rgb:ffffff,rgb:4c4c4c
face global PrimaryCursor          rgb:3f3f3f,rgb:ffffc8+fg
face global SecondaryCursor        rgb:3f3f3f,rgb:b2b2b2+fg
face global PrimaryCursorEol       rgb:3f3f3f,rgb:ffffc8+fg
face global SecondaryCursorEol     rgb:3f3f3f,rgb:646464+fg
face global MatchingChar           rgb:ffffc8+b
face global MenuForeground         rgb:3f3f3f,rgb:ffffff
face global MenuBackground         rgb:ffffff,rgb:231e14
face global MenuInfo               rgb:ffffff
face global Information            rgb:3f3f3f,rgb:ffffff
face global InlineInformation      rgb:ffffff,rgb:231e14
face global Error                  rgb:3f3f3f,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:2f2d28
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:3f3f3f,rgb:ffffc8
face global Prompt                 rgb:ffffff
face global BufferPadding          rgb:646464,rgb:3f3f3f
face global LineNumbers            rgb:646464,rgb:3f3f3f
face global LineNumberCursor       rgb:ffffff,rgb:3f3f3f+b
face global LineNumbersWrapped     rgb:646464,rgb:3f3f3f+i
face global Whitespace             rgb:797979+f
face global WrapMarker             rgb:797979+f
face global Search                 rgb:000000,rgb:5f5819
face global DiffAdd                rgb:ffffff,rgb:656565
face global DiffRm                 rgb:ffb4b4,rgb:655656
face global DiffMeta               rgb:ffffff,rgb:606058
face global MercurialCommitComment rgb:ffffff

