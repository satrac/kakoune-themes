# 10x-rdrdark theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/RDRDark.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:c8c8c8
face global type          rgb:c191ff
face global variable      rgb:bcbcbc
face global identifier    rgb:bcbcbc
face global module        rgb:c191ff
face global function      rgb:36ca78
face global method        rgb:36ca78
face global string        rgb:c9a26d
face global keyword       rgb:6c95eb
face global operator      rgb:bcbcbc
face global attribute     rgb:72d8dc
face global comment       rgb:85c46c
face global documentation rgb:85c46c
face global meta          rgb:6c95eb
face global builtin       rgb:c191ff+b
face global constant      rgb:c8c8c8
face global error         rgb:ffb4b4

# Markup
face global title  rgb:6c95eb+b
face global header rgb:72d8dc
face global mono   rgb:7f7f7f
face global block  rgb:e1bfff
face global link   rgb:6c95eb+u
face global bullet rgb:e6e6be
face global list   rgb:bbbbbb

# UI
face global Default                rgb:bbbbbb,rgb:262626
face global PrimarySelection       rgb:262626,rgb:08335e
face global SecondarySelection     rgb:bbbbbb,rgb:303030
face global PrimaryCursor          rgb:262626,rgb:f0f0f0+fg
face global SecondaryCursor        rgb:262626,rgb:7f7f7f+fg
face global PrimaryCursorEol       rgb:262626,rgb:f0f0f0+fg
face global SecondaryCursorEol     rgb:262626,rgb:646464+fg
face global MatchingChar           rgb:f0f0f0+b
face global MenuForeground         rgb:262626,rgb:6c95eb
face global MenuBackground         rgb:bbbbbb,rgb:3b3b3b
face global MenuInfo               rgb:6c95eb
face global Information            rgb:262626,rgb:ffd370
face global InlineInformation      rgb:bbbbbb,rgb:3b3b3b
face global Error                  rgb:262626,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:cdcdcd,rgb:3b3b3b
face global StatusLineMode         rgb:cdcdcd+b
face global StatusLineInfo         rgb:cdcdcd
face global StatusLineValue        rgb:cdcdcd+b
face global StatusCursor           rgb:262626,rgb:f0f0f0
face global Prompt                 rgb:6c95eb
face global BufferPadding          rgb:646464,rgb:262626
face global LineNumbers            rgb:646464,rgb:262626
face global LineNumberCursor       rgb:6c95eb,rgb:262626+b
face global LineNumbersWrapped     rgb:646464,rgb:262626+i
face global Whitespace             rgb:535353+f
face global WrapMarker             rgb:535353+f
face global Search                 rgb:ffffff,rgb:5f5819
face global DiffAdd                rgb:6fd85b,rgb:354a31
face global DiffRm                 rgb:ffb4b4,rgb:514242
face global DiffMeta               rgb:6c95eb,rgb:4c4c44
face global MercurialCommitComment rgb:85c46c

