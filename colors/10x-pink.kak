# 10x-pink theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Pink.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:ddbb99
face global type          rgb:ddbb99
face global variable      rgb:ddbb99
face global identifier    rgb:ddbb99
face global module        rgb:af5770
face global function      rgb:ddbb99
face global method        rgb:ddbb99
face global string        rgb:b49942
face global keyword       rgb:af5770
face global operator      rgb:af5770
face global attribute     rgb:72d8dc
face global comment       rgb:665544
face global documentation rgb:665544
face global meta          rgb:af5770
face global builtin       rgb:af5770+b
face global constant      rgb:ddbb99
face global error         rgb:ffb4b4

# Markup
face global title  rgb:af5770+b
face global header rgb:72d8dc
face global mono   rgb:8f7b69
face global block  rgb:ddbb99
face global link   rgb:af5770+u
face global bullet rgb:e6e6be
face global list   rgb:ddbb99

# UI
face global Default                rgb:ddbb99,rgb:1b1c20
face global PrimarySelection       rgb:1b1c20,rgb:49323d
face global SecondarySelection     rgb:ddbb99,rgb:292728
face global PrimaryCursor          rgb:1b1c20,rgb:af5770+fg
face global SecondaryCursor        rgb:1b1c20,rgb:8f7b69+fg
face global PrimaryCursorEol       rgb:1b1c20,rgb:af5770+fg
face global SecondaryCursorEol     rgb:1b1c20,rgb:ddbb99+fg
face global MatchingChar           rgb:af5770+b
face global MenuForeground         rgb:1b1c20,rgb:af5770
face global MenuBackground         rgb:ddbb99,rgb:1b1c20
face global MenuInfo               rgb:af5770
face global Information            rgb:1b1c20,rgb:ffd370
face global InlineInformation      rgb:ddbb99,rgb:1b1c20
face global Error                  rgb:1b1c20,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ddbb99,rgb:1b1c20
face global StatusLineMode         rgb:ddbb99+b
face global StatusLineInfo         rgb:ddbb99
face global StatusLineValue        rgb:ddbb99+b
face global StatusCursor           rgb:1b1c20,rgb:af5770
face global Prompt                 rgb:af5770
face global BufferPadding          rgb:ddbb99,rgb:1b1c20
face global LineNumbers            rgb:ddbb99,rgb:1b1c20
face global LineNumberCursor       rgb:af5770,rgb:1b1c20+b
face global LineNumbersWrapped     rgb:ddbb99,rgb:1b1c20+i
face global Whitespace             rgb:554c44+f
face global WrapMarker             rgb:554c44+f
face global Search                 rgb:ddbb99,rgb:49323d
face global DiffAdd                rgb:6fd85b,rgb:2c422c
face global DiffRm                 rgb:ffb4b4,rgb:493a3e
face global DiffMeta               rgb:af5770,rgb:444440
face global MercurialCommitComment rgb:665544

