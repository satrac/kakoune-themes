# vague theme for Kakoune
#
# Ported from the fresh-editor palette (palettes/fresh/vague.json), shared across the justaperlhacker editor themes.
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:aeaed1
face global type          rgb:9bb4bc
face global variable      rgb:cdcdcd
face global identifier    rgb:cdcdcd
face global module        rgb:9bb4bc
face global function      rgb:c48282
face global method        rgb:c48282
face global string        rgb:e8b589
face global keyword       rgb:6e94b2
face global operator      rgb:90a0b5
face global attribute     rgb:7e98e8
face global comment       rgb:606079+i
face global documentation rgb:7b7b8e
face global meta          rgb:b4d4cf
face global builtin       rgb:b4d4cf+b
face global constant      rgb:aeaed1
face global error         rgb:d8647e

# Markup
face global title  rgb:6e94b2+b
face global header rgb:7e98e8
face global mono   rgb:606079
face global block  rgb:6e94b2
face global link   rgb:6e94b2+u
face global bullet rgb:f3be7c
face global list   rgb:cdcdcd

# UI
face global Default                rgb:cdcdcd,rgb:141415
face global PrimarySelection       rgb:141415,rgb:2d3447
face global SecondarySelection     rgb:cdcdcd,rgb:262627
face global PrimaryCursor          rgb:141415,rgb:7e98e8+fg
face global SecondaryCursor        rgb:141415,rgb:606079+fg
face global PrimaryCursorEol       rgb:141415,rgb:7e98e8+fg
face global SecondaryCursorEol     rgb:141415,rgb:606079+fg
face global MatchingChar           rgb:7e98e8+b
face global MenuForeground         rgb:141415,rgb:6e94b2
face global MenuBackground         rgb:cdcdcd,rgb:1c1c24
face global MenuInfo               rgb:6e94b2
face global Information            rgb:141415,rgb:f3be7c
face global InlineInformation      rgb:cdcdcd,rgb:1c1c24
face global Error                  rgb:141415,rgb:d8647e
face global DiagnosticError        rgb:d8647e
face global DiagnosticWarning      rgb:f3be7c
face global StatusLine             rgb:ffffff,rgb:1c1c24
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:141415,rgb:7e98e8
face global Prompt                 rgb:6e94b2
face global BufferPadding          rgb:676768,rgb:141415
face global LineNumbers            rgb:606079,rgb:141415
face global LineNumberCursor       rgb:6e94b2,rgb:141415+b
face global LineNumbersWrapped     rgb:606079,rgb:141415+i
face global Whitespace             rgb:606079+f
face global WrapMarker             rgb:606079+f
face global Search                 rgb:ffffff,rgb:313c4a
