# 10x-sunset theme for Kakoune
#
# Ported from the 10x Editor color scheme (palettes/10x/Sunset.10x_settings).
#
# Generated by scripts/gen_themes.py -- do not edit by hand.

# Code
face global value         rgb:c8c8c8
face global type          rgb:73bedc
face global variable      rgb:a5dcff
face global identifier    rgb:a5dcff
face global module        rgb:82dcf4
face global function      rgb:ffc882
face global method        rgb:f9a768
face global string        rgb:c8d2dc
face global keyword       rgb:73bedc
face global operator      rgb:c8c8c8
face global attribute     rgb:72d8dc
face global comment       rgb:969696
face global documentation rgb:969696
face global meta          rgb:aabe8c
face global builtin       rgb:82dcf4+b
face global constant      rgb:c8c8c8
face global error         rgb:ffb4b4

# Markup
face global title  rgb:73bedc+b
face global header rgb:72d8dc
face global mono   rgb:8a8a8a
face global block  rgb:b477b9
face global link   rgb:73bedc+u
face global bullet rgb:e6e6be
face global list   rgb:d0d0d0

# UI
face global Default                rgb:d0d0d0,rgb:222222
face global PrimarySelection       rgb:222222,rgb:dcdc5a
face global SecondarySelection     rgb:d0d0d0,rgb:2e2e2e
face global PrimaryCursor          rgb:222222,rgb:ffffc8+fg
face global SecondaryCursor        rgb:222222,rgb:8a8a8a+fg
face global PrimaryCursorEol       rgb:222222,rgb:ffffc8+fg
face global SecondaryCursorEol     rgb:222222,rgb:646464+fg
face global MatchingChar           rgb:ffffc8+b
face global MenuForeground         rgb:222222,rgb:73bedc
face global MenuBackground         rgb:d0d0d0,rgb:231e14
face global MenuInfo               rgb:73bedc
face global Information            rgb:222222,rgb:ffd370
face global InlineInformation      rgb:d0d0d0,rgb:231e14
face global Error                  rgb:222222,rgb:ffb4b4
face global DiagnosticError        rgb:ffb4b4
face global DiagnosticWarning      rgb:e6e6be
face global StatusLine             rgb:ffffff,rgb:2f2d28
face global StatusLineMode         rgb:ffffff+b
face global StatusLineInfo         rgb:ffffff
face global StatusLineValue        rgb:ffffff+b
face global StatusCursor           rgb:222222,rgb:ffffc8
face global Prompt                 rgb:73bedc
face global BufferPadding          rgb:646464,rgb:222222
face global LineNumbers            rgb:646464,rgb:222222
face global LineNumberCursor       rgb:73bedc,rgb:222222+b
face global LineNumbersWrapped     rgb:646464,rgb:222222+i
face global Whitespace             rgb:565656+f
face global WrapMarker             rgb:565656+f
face global Search                 rgb:000000,rgb:5f5819
face global DiffAdd                rgb:6fd85b,rgb:31462d
face global DiffRm                 rgb:ffb4b4,rgb:4e3f3f
face global DiffMeta               rgb:73bedc,rgb:494941
face global MercurialCommitComment rgb:969696

