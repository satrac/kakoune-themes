face global module        rgb:8ea4a2
face global function      rgb:8ba4b0
face global method        rgb:8ba4b0
face global string        rgb:8a9a7b
face global keyword       rgb:8992a7
face global operator      rgb:909398
face global attribute     rgb:8ba4b0
face global comment       rgb:75797f+i
face global documentation rgb:898d91
face global meta          rgb:c4b28a
face global builtin       rgb:c4b28a+b
face global constant      rgb:b6927b
face global error         rgb:c4746e

# Markup
face global title  rgb:8992a7+b
face global header rgb:8ba4b0
face global mono   rgb:75797f
face global block  rgb:8992a7
face global link   rgb:8992a7+u
face global bullet rgb:c4b28a
face global list   rgb:c5c9c7

