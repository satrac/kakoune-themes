  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#bbbbbb",
    "variable.readonly": "#d4d4d4",
    "parameter": "#bbbbbb",
    "property": "#747474",
    "function": "#8b8b8b",
    "method": "#8b8b8b",
    "class": "#5e5e5e",
    "struct": "#5e5e5e",
    "interface": "#5e5e5e",
    "enum": "#5e5e5e",
    "enumMember": "#5e5e5e",
    "type": "#5e5e5e",
    "typeParameter": "#5e5e5e",
    "namespace": "#5e5e5e",
    "keyword": {
      "foreground": "#5e5e5e",
      "italic": true
    },
    "modifier": {
      "foreground": "#5e5e5e",
      "italic": true
    },
    "comment": {
      "foreground": "#494949",
      "italic": true
    },
    "string": "#d4d4d4",
    "number": "#eeeeee",
    "regexp": "#d4d4d4",
    "operator": "#eeeeee",
    "decorator": "#a3a3a3",
    "macro": "#d4d4d4",
    "label": "#eeeeee"
