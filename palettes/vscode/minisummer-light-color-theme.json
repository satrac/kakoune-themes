    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#2c2e33",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#2c2e33"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#804e00"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.definition.operator"
