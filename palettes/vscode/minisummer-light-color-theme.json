  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#2c2e33",
    "variable.readonly": "#006f44",
    "property": "#804e00",
    "function": "#007e87",
    "class": "#2c2e33",
    "struct": "#2c2e33",
    "interface": "#2c2e33",
    "enum": "#2c2e33",
    "enumMember": "#2c2e33",
    "type": "#2c2e33",
    "typeParameter": "#2c2e33",
    "keyword": {
      "foreground": "#2c2e33",
      "italic": true
    },
    "modifier": {
      "foreground": "#2c2e33",
      "italic": true
    },
    "comment": {
      "foreground": "#64666c",
      "italic": true
    },
    "string": "#636900",
    "number": "#370674",
    "regexp": "#006f44",
    "operator": "#2c2e33",
    "decorator": "#004d84",
    "label": "#2c2e33"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#64666c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#64666c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#636900"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "punctuation.definition.escape"
      ],
      "settings": {
        "foreground": "#006f44"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#006f44"
      }
    },
    {
      "scope": [
        "string.other",
        "string.special"
      ],
      "settings": {
        "foreground": "#006f44"
      }
    },
    {
      "scope": [
        "constant.other.symbol",
        "string.special.symbol"
      ],
      "settings": {
        "foreground": "#370674"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "text.literal"
      ],
      "settings": {
        "foreground": "#636900"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#370674"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#370674"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#370674"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#2c2e33"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#006f44"
      }
    },
    {
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#804e00"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#007e87"
      }
