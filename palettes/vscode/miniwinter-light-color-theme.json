    "statusBarItem.remoteForeground": "#dce4e8",
    "statusBarItem.hoverBackground": "#bcc4c8",

    "titleBar.activeBackground": "#e5edf1",
    "titleBar.activeForeground": "#312e29",
    "titleBar.inactiveBackground": "#dce4e8",
    "titleBar.inactiveForeground": "#4c4944",
    "titleBar.border": "#bcc4c8",

    "menu.background": "#e5edf1",
