    "list.hoverBackground": "#4e3819",
    "list.focusBackground": "#644c2c",
    "list.focusForeground": "#ebc295",
    "list.highlightForeground": "#83a598",
    "list.errorForeground": "#c33a2b",
    "list.warningForeground": "#f4aa2b",
    "list.dropBackground": "#83a59880",
    "listFilterWidget.background": "#372a16",
    "listFilterWidget.outline": "#83a598",

    "input.background": "#251d18",
    "input.foreground": "#d3af86",
    "input.border": "#4e3819",
    "input.placeholderForeground": "#907659",
    "inputOption.activeBorder": "#83a598",
    "inputOption.activeForeground": "#ebc295",
    "inputValidation.errorBackground": "#c33a2b33",
    "inputValidation.errorBorder": "#c33a2b",
    "inputValidation.warningBackground": "#f4aa2b33",
    "inputValidation.warningBorder": "#f4aa2b",
    "inputValidation.infoBackground": "#83a59833",
    "inputValidation.infoBorder": "#83a598",

    "dropdown.background": "#372a16",
    "dropdown.foreground": "#d3af86",
    "dropdown.border": "#4e3819",

    "button.background": "#83a598",
    "button.foreground": "#281f11",
    "button.hoverBackground": "#94b3a6",
    "button.secondaryBackground": "#644c2c",
    "button.secondaryForeground": "#ebc295",
    "button.secondaryHoverBackground": "#7c5f35",
    "button.border": "#4e3819",

    "badge.background": "#83a598",
    "badge.foreground": "#281f11",

    "progressBar.background": "#83a598",

    "scrollbar.shadow": "#1E170D55",
    "scrollbarSlider.background": "#8a693c66",
    "scrollbarSlider.hoverBackground": "#8a693c99",
    "scrollbarSlider.activeBackground": "#8a693ccc",

    "panel.background": "#30211c",
    "panel.border": "#4e3819",
    "panelTitle.activeBorder": "#83a598",
    "panelTitle.activeForeground": "#ebc295",
    "panelTitle.inactiveForeground": "#aa8c6b",
    "panel.dropBorder": "#83a59866",

    "terminal.background": "#281f11",
    "terminal.foreground": "#d3af86",
    "terminalCursor.foreground": "#d3af86",
    "terminal.selectionBackground": "#7c5f35",
    "terminal.ansiBlack": "#281f11",
    "terminal.ansiRed": "#c33a2b",
    "terminal.ansiGreen": "#889b4a",
    "terminal.ansiYellow": "#f4aa2b",
    "terminal.ansiBlue": "#83a598",
    "terminal.ansiMagenta": "#bb7d81",
    "terminal.ansiCyan": "#8ec07c",
    "terminal.ansiWhite": "#907659",
    "terminal.ansiBrightBlack": "#928374",
    "terminal.ansiBrightRed": "#c33a2b",
    "terminal.ansiBrightGreen": "#889b4a",
    "terminal.ansiBrightYellow": "#f4aa2b",
    "terminal.ansiBrightBlue": "#83a598",
    "terminal.ansiBrightMagenta": "#bb7d81",
    "terminal.ansiBrightCyan": "#8ec07c",
    "terminal.ansiBrightWhite": "#d3af86",

    "gitDecoration.addedResourceForeground": "#889b4a",
    "gitDecoration.modifiedResourceForeground": "#8ec07c",
    "gitDecoration.deletedResourceForeground": "#c33a2b",
    "gitDecoration.renamedResourceForeground": "#bb7d81",
    "gitDecoration.untrackedResourceForeground": "#907659",
    "gitDecoration.ignoredResourceForeground": "#928374",
    "gitDecoration.conflictingResourceForeground": "#f4aa2b",

    "notifications.background": "#372a16",
    "notifications.foreground": "#d3af86",
    "notifications.border": "#4e3819",
    "notificationCenterHeader.background": "#30211c",
    "notificationsErrorIcon.foreground": "#c33a2b",
    "notificationsWarningIcon.foreground": "#f4aa2b",
    "notificationsInfoIcon.foreground": "#83a598",

    "quickInput.background": "#372a16",
    "quickInput.foreground": "#d3af86",
    "quickInputList.focusBackground": "#644c2c",
    "quickInputList.focusForeground": "#ebc295",

    "pickerGroup.border": "#4e3819",
    "pickerGroup.foreground": "#83a598",

    "minimap.background": "#281f11",
    "minimap.selectionHighlight": "#7c5f35",
    "minimap.findMatchHighlight": "#f4aa2b",

    "editorGroupHeader.border": "#4e3819"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#83a598",
    "variable.readonly": "#bb7d81",
    "parameter": "#83a598",
    "property": "#83a598",
    "property.readonly": "#bb7d81",
    "function": { "foreground": "#db4664", "bold": true },
    "method": { "foreground": "#db4664", "bold": true },
    "class": "#f4aa2b",
    "struct": "#8ec07c",
    "interface": "#f4aa2b",
    "enum": "#f4aa2b",
    "enumMember": "#bb7d81",
    "type": "#f4aa2b",
    "typeParameter": "#f4aa2b",
    "namespace": "#83a598",
    "keyword": { "foreground": "#c33a2b", "italic": true },
    "modifier": { "foreground": "#e48212", "italic": true },
    "comment": { "foreground": "#928374", "italic": true },
    "string": "#889b4a",
    "number": "#bb7d81",
    "regexp": "#889b4a",
    "operator": "#e48212",
    "decorator": "#c33a2b",
    "macro": "#8ec07c",
    "label": "#c33a2b"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#928374", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#889b4a", "fontStyle": "italic" }
    },
    {
      "scope": ["string.regexp", "string.other"],
      "settings": { "foreground": "#889b4a" }
    },
    {
      "scope": ["constant.character.escape", "punctuation.definition.escape", "string.special"],
      "settings": { "foreground": "#8ec07c" }
    },
    {
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex"],
      "settings": { "foreground": "#bb7d81" }
    },
    {
      "scope": ["constant", "constant.language", "constant.character", "support.constant", "constant.other.symbol"],
      "settings": { "foreground": "#bb7d81" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#c33a2b", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.operator", "punctuation.definition.operator"],
      "settings": { "foreground": "#e48212" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#83a598" }
    },
    {
      "scope": ["variable.parameter", "variable.other.readwrite", "meta.function.parameters"],
      "settings": { "foreground": "#83a598" }
    },
    {
      "scope": ["variable.other.property", "variable.other.member", "meta.object-literal.key"],
      "settings": { "foreground": "#83a598" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.special"],
      "settings": { "foreground": "#e48212" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.method"],
      "settings": { "foreground": "#db4664", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function.macro", "support.function.macro", "meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#8ec07c" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "meta.type", "entity.name.enum", "entity.name.namespace", "storage.type.class"],
      "settings": { "foreground": "#f4aa2b" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#8ec07c" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class", "entity.other.attribute-name.id"],
      "settings": { "foreground": "#e48212" }
    },
    {
      "scope": ["meta.decorator", "punctuation.definition.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#c33a2b" }
    },
    {
      "scope": ["entity.name.section", "markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#889b4a", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.label"],
      "settings": { "foreground": "#c33a2b" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace", "punctuation.section"],
      "settings": { "foreground": "#e48212" }
    },
    {
      "scope": ["punctuation.special", "punctuation.list_marker", "punctuation.definition.list"],
      "settings": { "foreground": "#928374" }
    },
    {
      "scope": ["support.type.property-name", "support.type.property-name.css"],
      "settings": { "foreground": "#8ec07c" }
    },
    {
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#889b4a" }
    },
    {
      "scope": ["constant.other.color", "support.constant.color"],
      "settings": { "foreground": "#83a598" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold", "markup.bold.markdown"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#bb7d81", "fontStyle": "underline" }
    },
    {
      "scope": ["markup.inserted", "markup.inserted.git_gutter"],
      "settings": { "foreground": "#889b4a" }
    },
    {
      "scope": ["markup.deleted", "markup.deleted.git_gutter"],
      "settings": { "foreground": "#c33a2b" }
    },
    {
      "scope": ["markup.changed", "markup.changed.git_gutter"],
      "settings": { "foreground": "#8ec07c" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#928374", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": { "foreground": "#8ec07c" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#c33a2b" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#f4aa2b" }
    },
    {
      "scope": ["meta.brackets", "meta.embedded"],
      "settings": { "foreground": "#d3af86" }
    }
  ]
}
