    "titleBar.activeBackground": "#0E131D",
    "titleBar.activeForeground": "#FAFFF6",
    "titleBar.inactiveBackground": "#172030",
    "titleBar.inactiveForeground": "#64727d",
    "titleBar.border": "#1F2A3F",

    "menu.background": "#151D2B",
    "menu.foreground": "#FAFFF6",
    "menu.selectionBackground": "#1F2A3F",
    "menu.selectionForeground": "#FAFFF6",
    "menu.border": "#1F2A3F",
    "menu.separatorBackground": "#1F2A3F",

    "tab.activeBackground": "#B16E75",
    "tab.activeForeground": "#F0F4FC",
    "tab.activeBorderTop": "#F0F4FC",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#101828",
    "tab.inactiveForeground": "#64727d",
    "tab.border": "#1F2A3F",
    "tab.hoverBackground": "#151D2B",
    "tab.hoverForeground": "#FAFFF6",
    "tab.unfocusedActiveForeground": "#F0F4FC",
    "tab.unfocusedInactiveForeground": "#64727d",

    "editorGroupHeader.tabsBackground": "#101828",
    "editorGroupHeader.tabsBorder": "#1F2A3F",
    "editorGroupHeader.noTabsBackground": "#101828",
    "editorGroup.border": "#1F2A3F",
    "editorGroup.dropBackground": "#DB6E8F80",

    "breadcrumb.background": "#172030",
    "breadcrumb.foreground": "#64727d",
    "breadcrumb.focusForeground": "#FAFFF6",
    "breadcrumb.activeSelectionForeground": "#DB6E8F",
    "breadcrumbPicker.background": "#151D2B",

    "list.activeSelectionBackground": "#1F2A3F",
    "list.activeSelectionForeground": "#FAFFF6",
    "list.inactiveSelectionBackground": "#151D2B",
    "list.inactiveSelectionForeground": "#A7ACB9",
    "list.hoverBackground": "#151D2B",
    "list.focusBackground": "#1F2A3F",
    "list.focusForeground": "#FAFFF6",
    "list.highlightForeground": "#DB6E8F",
    "list.errorForeground": "#c6797e",
    "list.warningForeground": "#F7E3AF",
    "list.dropBackground": "#DB6E8F80",
    "listFilterWidget.background": "#151D2B",
    "listFilterWidget.outline": "#DB6E8F",

    "input.background": "#0E131D",
    "input.foreground": "#FAFFF6",
    "input.border": "#1F2A3F",
    "input.placeholderForeground": "#64727d",
    "inputOption.activeBorder": "#DB6E8F",
    "inputOption.activeForeground": "#FAFFF6",
    "inputValidation.errorBackground": "#c6797e33",
    "inputValidation.errorBorder": "#c6797e",
    "inputValidation.warningBackground": "#F7E3AF33",
    "inputValidation.warningBorder": "#F7E3AF",
    "inputValidation.infoBackground": "#6e94b933",
    "inputValidation.infoBorder": "#6e94b9",

    "dropdown.background": "#151D2B",
    "dropdown.foreground": "#FAFFF6",
    "dropdown.border": "#1F2A3F",

    "button.background": "#DB6E8F",
    "button.foreground": "#172030",
    "button.hoverBackground": "#e2859f",
    "button.secondaryBackground": "#1F2A3F",
    "button.secondaryForeground": "#FAFFF6",
    "button.secondaryHoverBackground": "#5D636E",
    "button.border": "#1F2A3F",

    "badge.background": "#DB6E8F",
    "badge.foreground": "#172030",

    "progressBar.background": "#DB6E8F",

    "scrollbar.shadow": "#070A0E55",
    "scrollbarSlider.background": "#5D636E66",
    "scrollbarSlider.hoverBackground": "#64727d99",
    "scrollbarSlider.activeBackground": "#64727dcc",

    "panel.background": "#101828",
    "panel.border": "#1F2A3F",
    "panelTitle.activeBorder": "#DB6E8F",
    "panelTitle.activeForeground": "#FAFFF6",
    "panelTitle.inactiveForeground": "#64727d",
    "panel.dropBorder": "#DB6E8F66",

    "terminal.background": "#172030",
    "terminal.foreground": "#FAFFF6",
    "terminalCursor.foreground": "#FAFFF6",
    "terminal.selectionBackground": "#5D636E",
    "terminal.ansiBlack": "#070A0E",
    "terminal.ansiRed": "#c6797e",
    "terminal.ansiGreen": "#A3B09A",
    "terminal.ansiYellow": "#F7E3AF",
    "terminal.ansiBlue": "#6e94b9",
    "terminal.ansiMagenta": "#b18bb1",
    "terminal.ansiCyan": "#88C0D0",
    "terminal.ansiWhite": "#E8E9EB",
    "terminal.ansiBrightBlack": "#5D636E",
    "terminal.ansiBrightRed": "#DB6E8F",
    "terminal.ansiBrightGreen": "#7ea9a9",
    "terminal.ansiBrightYellow": "#F7E3AF",
    "terminal.ansiBrightBlue": "#5D80AE",
    "terminal.ansiBrightMagenta": "#b18bb1",
    "terminal.ansiBrightCyan": "#88C0D0",
    "terminal.ansiBrightWhite": "#F0F4FC",

    "gitDecoration.addedResourceForeground": "#A3B09A",
    "gitDecoration.modifiedResourceForeground": "#eabe9a",
    "gitDecoration.deletedResourceForeground": "#c6797e",
    "gitDecoration.renamedResourceForeground": "#7ea9a9",
    "gitDecoration.untrackedResourceForeground": "#A7ACB9",
    "gitDecoration.ignoredResourceForeground": "#64727d",
    "gitDecoration.conflictingResourceForeground": "#eabe9a",

    "notifications.background": "#151D2B",
    "notifications.foreground": "#FAFFF6",
    "notifications.border": "#1F2A3F",
    "notificationCenterHeader.background": "#101828",
    "notificationsErrorIcon.foreground": "#c6797e",
    "notificationsWarningIcon.foreground": "#F7E3AF",
    "notificationsInfoIcon.foreground": "#6e94b9",

    "quickInput.background": "#151D2B",
    "quickInput.foreground": "#FAFFF6",
    "quickInputList.focusBackground": "#1F2A3F",
    "quickInputList.focusForeground": "#FAFFF6",

    "pickerGroup.border": "#1F2A3F",
    "pickerGroup.foreground": "#DB6E8F",

    "minimap.background": "#172030",
    "minimap.selectionHighlight": "#5D636E",
    "minimap.findMatchHighlight": "#B16E75",

    "editorGroupHeader.border": "#1F2A3F"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#c6797e",
    "variable.readonly": "#DB6E8F",
    "parameter": "#c6797e",
    "property": "#c6797e",
    "property.readonly": "#DB6E8F",
    "function": "#F9B5AC",
    "method": "#DB6E8F",
    "class": "#c6797e",
    "struct": "#c6797e",
    "interface": "#c6797e",
    "enum": "#c6797e",
    "enumMember": "#c6797e",
    "type": "#c6797e",
    "typeParameter": "#c6797e",
    "namespace": "#c6797e",
    "keyword": { "foreground": "#b18bb1", "italic": true },
    "modifier": { "foreground": "#b18bb1", "italic": true },
    "comment": { "foreground": "#64727d", "italic": true },
    "string": "#A3B09A",
    "number": "#eabe9a",
    "regexp": "#eabe9a",
    "operator": "#b18bb1",
    "decorator": "#DB6E8F",
    "macro": "#b18bb1",
    "label": "#DB6E8F"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#64727d", "fontStyle": "italic" }
    },
    {
      "scope": ["comment.block.documentation", "comment.line.documentation"],
      "settings": { "foreground": "#A3B09A", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#A3B09A" }
    },
    {
      "scope": ["string.regexp", "constant.character.escape", "punctuation.definition.escape", "string.other"],
      "settings": { "foreground": "#eabe9a" }
    },
    {
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex"],
      "settings": { "foreground": "#eabe9a" }
    },
    {
      "scope": ["constant", "constant.language", "constant.character", "support.constant", "constant.other.symbol"],
      "settings": { "foreground": "#c6797e" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#b18bb1", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.operator", "punctuation.definition.operator"],
      "settings": { "foreground": "#b18bb1" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#c6797e" }
    },
    {
      "scope": ["variable.parameter", "variable.other.readwrite", "meta.function.parameters"],
      "settings": { "foreground": "#c6797e" }
    },
    {
      "scope": ["variable.other.property", "variable.other.member", "meta.object-literal.key"],
      "settings": { "foreground": "#c6797e" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.special"],
      "settings": { "foreground": "#DB6E8F" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#F9B5AC" }
    },
    {
      "scope": ["entity.name.function.method", "meta.method", "entity.name.method"],
      "settings": { "foreground": "#DB6E8F" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "meta.type", "entity.name.enum", "entity.name.namespace"],
      "settings": { "foreground": "#c6797e" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#c6797e" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class", "entity.other.attribute-name.id"],
      "settings": { "foreground": "#eabe9a" }
    },
    {
      "scope": ["meta.decorator", "punctuation.definition.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#DB6E8F" }
    },
    {
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#b18bb1", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.section", "markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#c6797e", "fontStyle": "bold" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace", "punctuation.section"],
      "settings": { "foreground": "#A7ACB9" }
    },
    {
      "scope": ["punctuation.special", "punctuation.list_marker", "punctuation.definition.list"],
      "settings": { "foreground": "#DB6E8F" }
    },
    {
      "scope": ["support.type.property-name", "support.type.property-name.css"],
      "settings": { "foreground": "#A3B09A" }
    },
    {
      "scope": ["support.type.property-name.css.proprietary", "meta.property-name.css"],
      "settings": { "foreground": "#eabe9a" }
    },
    {
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css"],
      "settings": { "foreground": "#6e94b9" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold", "markup.bold.markdown"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#6e94b9", "fontStyle": "underline" }
    },
    {
      "scope": ["markup.inserted", "markup.inserted.git_gutter"],
      "settings": { "foreground": "#A3B09A" }
    },
    {
      "scope": ["markup.deleted", "markup.deleted.git_gutter"],
      "settings": { "foreground": "#c6797e" }
    },
    {
      "scope": ["markup.changed", "markup.changed.git_gutter"],
      "settings": { "foreground": "#eabe9a" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#7ea9a9", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": { "foreground": "#A3B09A" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#c6797e" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#F7E3AF" }
    },
    {
      "scope": ["meta.brackets", "meta.embedded"],
      "settings": { "foreground": "#FAFFF6" }
    }
  ]
}
